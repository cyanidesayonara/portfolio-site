---
/*
  Interactive 128x128 Coriolis LED wall emulator on /projects/coriolis.
  Runs the real C++11 core/ and scenes/ engine compiled to WebAssembly
  (/coriolis/coriolis.js + /coriolis/coriolis.wasm) with keyboard controls
  and virtual IR remote buttons.
*/
import type { Locale } from '../i18n/utils';
import { getUi } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const ui = getUi(locale).coriolisSim;
---

<section class="coriolis-sim" data-coriolis-sim tabindex="0" aria-label={ui.sectionAria}>
  <div class="sim-head">
    <div>
      <span class="sim-badge">{ui.badge}</span>
      <h2>{ui.heading}</h2>
    </div>
    <div class="quick" role="group" aria-label={ui.quickAria}>
      {ui.quickScenes.map((q) => <button type="button" data-scene-idx={q.idx}>{q.label}</button>)}
    </div>
  </div>

  <div class="sim-stage">
    <div class="bezel">
      <canvas width="640" height="640" data-sim-canvas role="img" aria-label={ui.canvasAria}></canvas>
      <div class="sim-meta">
        <span data-sim-scene>{ui.loading}</span>
        <span data-sim-palette></span>
      </div>
    </div>

    <div class="remote" aria-label={ui.remoteAria}>
      <p class="remote-label">{ui.remoteLabel}</p>
      <div class="dpad">
        <button type="button" class="up" data-key="1" aria-label={ui.upAria}>▲</button>
        <button type="button" class="left" data-key="3" aria-label={ui.leftAria}>◀</button>
        <button type="button" class="ok" data-key="5">{ui.okLabel}</button>
        <button type="button" class="right" data-key="4" aria-label={ui.rightAria}>▶</button>
        <button type="button" class="down" data-key="2" aria-label={ui.downAria}>▼</button>
      </div>

      <div class="cmd-grid">
        <button type="button" data-cmd="1"><kbd>M</kbd> {ui.launcher}</button>
        <button type="button" data-cmd="2"><kbd>S</kbd> {ui.settings}</button>
        <button type="button" data-cmd="3"><kbd>C</kbd> {ui.clockOverlay}</button>
        <button type="button" data-key="6"><kbd>⌫</kbd> {ui.back}</button>
        <button type="button" data-cmd="4"><kbd>Space</kbd> {ui.nextScene}</button>
        <button type="button" data-cmd="5"><kbd>H</kbd> {ui.home}</button>
        <button type="button" data-rotate><kbd>R</kbd> {ui.rotate}</button>
        <button type="button" data-night aria-pressed="false"><kbd>N</kbd> {ui.nightMode}</button>
        <button
          type="button"
          data-audio
          aria-pressed="false"
          data-label-on={ui.soundOn}
          data-label-off={ui.soundOff}
        ><kbd>A</kbd> {ui.soundOff}</button>
        <a class="full-emu" href="https://cyanidesayonara.github.io/coriolis/#try" rel="noopener">{ui.fullShowcase}</a>
      </div>

      <p class="remote-hint">{ui.hint}</p>
    </div>
  </div>
</section>

<script>
  interface CoriolisWasmModule {
    HEAPU8: Uint8Array;
    UTF8ToString(ptr: number): string;
    _coriolis_init(showSplash: number): void;
    _coriolis_set_time(y: number, m: number, d: number, h: number, min: number, s: number): void;
    _coriolis_tick(nowMs: number): number;
    _coriolis_rgba_ptr(): number;
    _coriolis_key(keyId: number): number;
    _coriolis_cmd(cmdId: number): void;
    _coriolis_set_held(keyId: number, down: number): void;
    _coriolis_show(sceneIndex: number): void;
    _coriolis_rotate(): void;
    _coriolis_toggle_night(): number;
    _coriolis_night_enabled(): number;
    _coriolis_active_name(): number;
    _coriolis_palette_name(): number;
  }

  declare global {
    interface Window {
      CoriolisModule?: (opts: { locateFile: (path: string) => string }) => Promise<CoriolisWasmModule>;
      _coriolisAudio?: {
        play(cueId: number): void;
        voice(clip: number): void;
        loop(cueId: number): void;
        setVolume(v: number): void;
      };
    }
  }

  const MATRIX_W = 128;
  const MATRIX_H = 128;
  const PIXEL_BYTES = MATRIX_W * MATRIX_H * 4;

  const root = document.querySelector<HTMLElement>('[data-coriolis-sim]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-sim-canvas]');
  const ctx2d = canvas?.getContext('2d', { alpha: false });
  const sceneEl = root?.querySelector<HTMLElement>('[data-sim-scene]');
  const palEl = root?.querySelector<HTMLElement>('[data-sim-palette]');
  const audioBtn = root?.querySelector<HTMLButtonElement>('[data-audio]');
  const nightBtn = root?.querySelector<HTMLButtonElement>('[data-night]');

  if (root && canvas && ctx2d) {
    // Web Audio cue synthesizer matching SimAudio / site/emu.js
    const CUE_MAP: Record<number, [number, number, boolean]> = {
      1: [880, 90, false],
      2: [660, 170, false],
      3: [523, 240, false],
      4: [988, 110, false],
      5: [1175, 35, true],
      6: [523, 220, false],
      7: [440, 90, false],
      8: [392, 280, false],
      9: [190, 55, true],
      11: [1046, 45, false],
      12: [320, 340, true],
      13: [640, 25, false],
      14: [784, 140, false],
    };
    let audioEnabled = false;
    let audioVolume = 20;
    let audioCtx: AudioContext | null = null;
    const ensureAudioCtx = () => {
      if (!audioCtx && window.AudioContext) audioCtx = new AudioContext();
      if (audioCtx && audioCtx.state === 'suspended') void audioCtx.resume().catch(() => {});
    };
    const playTone = (freq: number, ms: number, descend: boolean) => {
      if (!audioEnabled || audioVolume <= 0) return;
      ensureAudioCtx();
      if (!audioCtx) return;
      const now = audioCtx.currentTime;
      const dur = ms / 1000;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      const peak = Math.min(0.25, (audioVolume / 30) * 0.22);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, now);
      if (descend) osc.frequency.linearRampToValueAtTime(freq * 0.4, now + dur);
      gain.gain.setValueAtTime(peak, now);
      gain.gain.linearRampToValueAtTime(0.0001, now + dur);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + dur + 0.01);
    };
    window._coriolisAudio = {
      play: (cueId) => { const s = CUE_MAP[cueId]; if (s) playTone(s[0], s[1], s[2]); },
      voice: () => playTone(700, 70, false),
      loop: () => {},
      setVolume: (v) => { audioVolume = v; },
    };

    const offscreen = document.createElement('canvas');
    offscreen.width = MATRIX_W;
    offscreen.height = MATRIX_H;
    const offCtx = offscreen.getContext('2d', { alpha: false })!;
    const imgData = offCtx.createImageData(MATRIX_W, MATRIX_H);

    // Subtle HUB75 LED pixel-pitch mask baked once for the 640x640 panel.
    const gridMask = document.createElement('canvas');
    gridMask.width = canvas.width;
    gridMask.height = canvas.height;
    {
      const g = gridMask.getContext('2d')!;
      const cell = canvas.width / MATRIX_W;
      g.fillStyle = 'rgba(0, 0, 0, 0.36)';
      for (let i = 0; i < canvas.width; i += cell) g.fillRect(i + cell - 1, 0, 1, canvas.height);
      for (let j = 0; j < canvas.height; j += cell) g.fillRect(0, j + cell - 1, canvas.width, 1);
    }

    let mod: CoriolisWasmModule | null = null;
    let rgbaPtr = 0;
    let startPerf = performance.now();
    let active = false;
    let lastScene = '';
    let lastPalette = '';
    let lastNight = -1;

    const syncMeta = () => {
      if (!mod) return;
      const sc = mod.UTF8ToString(mod._coriolis_active_name());
      const pal = mod.UTF8ToString(mod._coriolis_palette_name());
      const night = mod._coriolis_night_enabled();
      if (sc !== lastScene) {
        lastScene = sc;
        if (sceneEl) sceneEl.textContent = sc;
      }
      if (pal !== lastPalette) {
        lastPalette = pal;
        if (palEl) palEl.textContent = pal;
      }
      if (night !== lastNight) {
        lastNight = night;
        nightBtn?.setAttribute('aria-pressed', night ? 'true' : 'false');
      }
    };

    const syncClock = () => {
      if (!mod) return;
      const d = new Date();
      mod._coriolis_set_time(d.getFullYear(), d.getMonth() + 1, d.getDate(), d.getHours(), d.getMinutes(), d.getSeconds());
    };

    const paintFrame = () => {
      if (!mod || !rgbaPtr) return;
      imgData.data.set(mod.HEAPU8.subarray(rgbaPtr, rgbaPtr + PIXEL_BYTES));
      offCtx.putImageData(imgData, 0, 0);
      ctx2d.imageSmoothingEnabled = false;
      ctx2d.drawImage(offscreen, 0, 0, canvas.width, canvas.height);
      ctx2d.drawImage(gridMask, 0, 0);
    };

    const clearHeld = () => {
      if (!mod) return;
      for (let k = 1; k <= 6; k++) mod._coriolis_set_held(k, 0);
    };

    const syncAudioBtn = () => {
      if (!audioBtn) return;
      audioBtn.setAttribute('aria-pressed', String(audioEnabled));
      const label = audioEnabled ? (audioBtn.dataset.labelOn ?? 'Sound on') : (audioBtn.dataset.labelOff ?? 'Sound off');
      audioBtn.innerHTML = `<kbd>A</kbd> ${label}`;
    };
    const toggleAudio = () => {
      audioEnabled = !audioEnabled;
      if (audioEnabled) ensureAudioCtx();
      syncAudioBtn();
    };
    audioBtn?.addEventListener('click', toggleAudio);
    nightBtn?.addEventListener('click', () => {
      if (!mod) return;
      mod._coriolis_toggle_night();
      syncMeta();
    });

    const KEYMAP: Record<string, number> = {
      ArrowUp: 1,
      ArrowDown: 2,
      ArrowLeft: 3,
      ArrowRight: 4,
      Enter: 5,
      Backspace: 6,
      Escape: 6,
    };

    canvas.addEventListener('click', () => {
      active = true;
      root.focus({ preventScroll: true });
    });
    root.addEventListener('focus', () => { active = true; });
    root.addEventListener('blur', () => { active = false; clearHeld(); });

    root.addEventListener('keydown', (e) => {
      if (!mod || (!active && document.activeElement !== root)) return;
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const mapped = KEYMAP[e.code];
      if (mapped) {
        e.preventDefault();
        if (audioEnabled) ensureAudioCtx();
        mod._coriolis_set_held(mapped, 1);
        if (!e.repeat || mapped <= 4) mod._coriolis_key(mapped);
        syncMeta();
        return;
      }
      if (e.repeat) return;
      switch (e.code) {
        case 'KeyM': e.preventDefault(); mod._coriolis_cmd(1); break;
        case 'KeyS': e.preventDefault(); mod._coriolis_cmd(2); break;
        case 'KeyC': e.preventDefault(); mod._coriolis_cmd(3); break;
        case 'Space': e.preventDefault(); mod._coriolis_cmd(4); break;
        case 'KeyH': e.preventDefault(); mod._coriolis_cmd(5); break;
        case 'KeyR': e.preventDefault(); mod._coriolis_rotate(); break;
        case 'KeyN': e.preventDefault(); mod._coriolis_toggle_night(); break;
        case 'KeyA': e.preventDefault(); toggleAudio(); break;
        default: return;
      }
      syncMeta();
    });

    root.addEventListener('keyup', (e) => {
      if (!mod) return;
      const mapped = KEYMAP[e.code];
      if (mapped) mod._coriolis_set_held(mapped, 0);
    });

    root.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((btn) => {
      const k = parseInt(btn.dataset.key!, 10);
      const down = (ev: Event) => {
        ev.preventDefault();
        root.focus({ preventScroll: true });
        if (audioEnabled) ensureAudioCtx();
        if (mod) {
          mod._coriolis_set_held(k, 1);
          mod._coriolis_key(k);
          syncMeta();
        }
      };
      const up = () => { if (mod) mod._coriolis_set_held(k, 0); };
      btn.addEventListener('pointerdown', down);
      btn.addEventListener('pointerup', up);
      btn.addEventListener('pointerleave', up);
      btn.addEventListener('pointercancel', up);
    });

    root.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((btn) => {
      const cmd = parseInt(btn.dataset.cmd!, 10);
      btn.addEventListener('click', () => {
        root.focus({ preventScroll: true });
        if (audioEnabled) ensureAudioCtx();
        if (mod) {
          mod._coriolis_cmd(cmd);
          syncMeta();
        }
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-scene-idx]').forEach((btn) => {
      const idx = parseInt(btn.dataset.sceneIdx!, 10);
      btn.addEventListener('click', () => {
        root.focus({ preventScroll: true });
        if (audioEnabled) ensureAudioCtx();
        if (mod) {
          mod._coriolis_show(idx);
          syncMeta();
        }
      });
    });

    root.querySelector<HTMLButtonElement>('[data-rotate]')?.addEventListener('click', () => {
      if (mod) {
        mod._coriolis_rotate();
        syncMeta();
      }
    });

    let engaged = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let onScreen = true;
    let rafId = 0;
    const frame = () => {
      if (mod) {
        syncClock();
        const elapsed = Math.max(0, Math.floor(performance.now() - startPerf));
        if (mod._coriolis_tick(elapsed)) paintFrame();
        syncMeta();
      }
      rafId = requestAnimationFrame(frame);
    };
    const setRunning = () => {
      const run = Boolean(mod) && engaged && onScreen && !document.hidden;
      if (run && !rafId) rafId = requestAnimationFrame(frame);
      else if (!run && rafId) { cancelAnimationFrame(rafId); rafId = 0; clearHeld(); }
    };
    new IntersectionObserver(([entry]) => { onScreen = entry.isIntersecting; setRunning(); }).observe(canvas);
    document.addEventListener('visibilitychange', setRunning);
    const engage = () => { if (!engaged) { engaged = true; setRunning(); } };
    root.addEventListener('focus', engage);
    root.addEventListener('pointerdown', engage);

    const loadScript = (src: string) => new Promise<void>((resolve, reject) => {
      if (typeof window.CoriolisModule === 'function') { resolve(); return; }
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(s);
    });

    void loadScript('/coriolis/coriolis.js')
      .then(() => {
        if (typeof window.CoriolisModule !== 'function') throw new Error('CoriolisModule missing');
        return window.CoriolisModule({ locateFile: (path) => `/coriolis/${path}` });
      })
      .then((instance) => {
        mod = instance;
        startPerf = performance.now();
        syncClock();
        mod._coriolis_init(1);
        rgbaPtr = mod._coriolis_rgba_ptr();
        paintFrame();
        syncMeta();
        setRunning();
      })
      .catch((err) => {
        console.error('Coriolis WASM emulator error:', err);
        if (sceneEl) sceneEl.textContent = 'Emulator unavailable';
      });
  }
</script>

<style>
  .coriolis-sim {
    margin-block: 36px 8px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: var(--radius-l);
    background: var(--navy);
    color: var(--stone);
    border: 1px solid #2a3a63;
  }
  .coriolis-sim:focus-visible {
    outline: 3px solid var(--led);
    outline-offset: 4px;
  }
  .sim-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 24px;
  }
  .sim-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(94, 234, 140, 0.14);
    color: var(--led);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .sim-head h2 {
    font-size: clamp(24px, 3vw, 32px);
    color: var(--stone);
  }
  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .quick button {
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid #304270;
    background: #101933;
    color: var(--ink-soft-dark);
    font: 600 13px/1 var(--font-body);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  .quick button:hover {
    border-color: var(--led);
    color: var(--stone);
    background: #18264c;
  }
  .sim-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(240px, 1fr);
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 820px) {
    .sim-stage {
      grid-template-columns: 1fr;
    }
  }
  .bezel {
    padding: 14px;
    border-radius: var(--radius-m);
    background: #07090e;
    border: 2px solid #243256;
    box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.7), 0 12px 30px rgba(0, 0, 0, 0.35);
  }
  canvas {
    display: block;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1;
    margin-inline: auto;
    border-radius: 6px;
    image-rendering: pixelated;
    cursor: pointer;
  }
  .sim-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #1b2540;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-soft-dark);
  }
  .remote {
    padding: 20px;
    border-radius: var(--radius-m);
    background: #0e162e;
    border: 1px solid #243256;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .remote-label {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft-dark);
  }
  .dpad {
    display: grid;
    grid-template-columns: repeat(3, 52px);
    grid-template-rows: repeat(3, 48px);
    gap: 6px;
    justify-content: center;
  }
  .dpad button {
    border-radius: 12px;
    border: 1px solid #314373;
    background: #172347;
    color: var(--stone);
    font: 700 15px/1 var(--font-body);
    cursor: pointer;
    user-select: none;
    touch-action: manipulation;
  }
  .dpad button:hover {
    border-color: var(--led);
  }
  .dpad button:active {
    background: var(--led);
    color: var(--navy-deep);
  }
  .dpad .up { grid-column: 2; grid-row: 1; }
  .dpad .left { grid-column: 1; grid-row: 2; }
  .dpad .ok { grid-column: 2; grid-row: 2; background: var(--led); color: var(--navy-deep); border-color: var(--led); }
  .dpad .right { grid-column: 3; grid-row: 2; }
  .dpad .down { grid-column: 2; grid-row: 3; }

  .cmd-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .cmd-grid button,
  .cmd-grid .full-emu {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 10px;
    border-radius: 10px;
    border: 1px solid #2a3a63;
    background: #131e3d;
    color: var(--stone);
    font: 500 13px/1.2 var(--font-body);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .cmd-grid button:hover,
  .cmd-grid .full-emu:hover {
    border-color: var(--saffron);
  }
  .cmd-grid .full-emu {
    color: var(--led);
    justify-content: center;
    font-weight: 600;
  }
  .cmd-grid button[aria-pressed='true'] {
    border-color: var(--led);
    color: var(--led);
  }
  .cmd-grid kbd {
    padding: 2px 6px;
    border-radius: 5px;
    background: #091024;
    border: 1px solid #304270;
    font: 600 11px/1.3 var(--font-body);
    color: var(--ink-soft-dark);
  }
  .remote-hint {
    font-size: 13px;
    color: var(--ink-soft-dark);
    line-height: 1.5;
  }
</style>
