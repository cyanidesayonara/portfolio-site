---
/*
  Interactive 128x128 Coriolis LED wall simulator, embedded on /projects/coriolis.
  Supports keyboard (same bindings as the C++ raylib simulator) and clickable IR
  remote buttons, plus quick-jump chips for flagship scenes.
*/
---

<section class="coriolis-sim" data-coriolis-sim tabindex="0" aria-label="Interactive Coriolis 128 by 128 LED wall simulator">
  <div class="sim-head">
    <div>
      <span class="sim-badge">Live simulator · 128×128 LED matrix</span>
      <h2>Try the wall display in your browser</h2>
    </div>
    <div class="quick" role="group" aria-label="Quick scenes">
      <button type="button" data-scene="clock">Clock</button>
      <button type="button" data-scene="coriolis">Coriolis</button>
      <button type="button" data-scene="aurora">Aurora</button>
      <button type="button" data-scene="fire">Fireplace</button>
      <button type="button" data-scene="yoga">Yoga</button>
      <button type="button" data-scene="snake">Snake</button>
      <button type="button" data-scene="tetris">Tetris</button>
      <button type="button" data-scene="labyrinth">Labyrinth</button>
    </div>
  </div>

  <div class="sim-stage">
    <div class="bezel">
      <canvas width="640" height="640" data-sim-canvas></canvas>
      <div class="sim-meta">
        <span data-sim-scene>Hello</span>
        <span data-sim-palette>Rainbow</span>
      </div>
    </div>

    <div class="remote" aria-label="Virtual IR remote">
      <p class="remote-label">IR Remote &amp; Controls</p>
      <div class="dpad">
        <button type="button" class="up" data-key="Up" aria-label="Up">▲</button>
        <button type="button" class="left" data-key="Left" aria-label="Left">◀</button>
        <button type="button" class="ok" data-key="Select">OK</button>
        <button type="button" class="right" data-key="Right" aria-label="Right">▶</button>
        <button type="button" class="down" data-key="Down" aria-label="Down">▼</button>
      </div>

      <div class="cmd-grid">
        <button type="button" data-cmd="Menu"><kbd>M</kbd> Launcher</button>
        <button type="button" data-cmd="Settings"><kbd>S</kbd> Settings</button>
        <button type="button" data-cmd="Overlay"><kbd>C</kbd> Clock overlay</button>
        <button type="button" data-key="Back"><kbd>⌫</kbd> Back</button>
        <button type="button" data-cmd="Next"><kbd>Space</kbd> Next scene</button>
        <button type="button" data-cmd="Home"><kbd>H</kbd> Home</button>
        <button type="button" data-rotate><kbd>R</kbd> Rotate 90°</button>
        <button type="button" data-audio aria-pressed="false"><kbd>A</kbd> Sound off</button>
      </div>

      <p class="remote-hint">
        Click the LED panel or use the remote buttons. Arrows navigate, play Snake/Pong/Tetris/Labyrinth, or switch palettes on ambient scenes.
      </p>
    </div>
  </div>
</section>

<script>
  import { CoriolisSimulator, type SimCommand, type SimKey } from '../scripts/coriolis/sim';

  const root = document.querySelector<HTMLElement>('[data-coriolis-sim]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-sim-canvas]');
  const ctx2d = canvas?.getContext('2d');
  const sceneEl = root?.querySelector<HTMLElement>('[data-sim-scene]');
  const palEl = root?.querySelector<HTMLElement>('[data-sim-palette]');
  const audioBtn = root?.querySelector<HTMLButtonElement>('[data-audio]');

  if (root && canvas && ctx2d) {
    const sim = new CoriolisSimulator();
    let active = false;

    const syncMeta = () => {
      if (sceneEl) sceneEl.textContent = sim.activeLabel();
      if (palEl) palEl.textContent = sim.paletteName();
    };

    const KEYMAP: Record<string, SimKey> = {
      ArrowUp: 'Up',
      KeyW: 'Up',
      ArrowDown: 'Down',
      KeyS: 'Down',
      ArrowLeft: 'Left',
      KeyA: 'Left',
      ArrowRight: 'Right',
      KeyD: 'Right',
      Enter: 'Select',
      Backspace: 'Back',
      Escape: 'Back',
    };

    canvas.addEventListener('click', () => {
      active = true;
      root.focus();
    });

    root.addEventListener('focus', () => { active = true; });
    root.addEventListener('blur', () => { active = false; sim.clearHeld(); });

    const onKeyDown = (e: KeyboardEvent) => {
      if (!active && document.activeElement !== root) return;
      const now = performance.now();
      const mapped = KEYMAP[e.code];
      if (mapped && !['KeyW', 'KeyA', 'KeyS', 'KeyD'].includes(e.code)) {
        e.preventDefault();
        sim.setHeld(mapped, true);
        if (!e.repeat || ['Up', 'Down', 'Left', 'Right'].includes(mapped)) sim.key(mapped, now);
        syncMeta();
        return;
      }
      if (e.code === 'KeyM') { e.preventDefault(); sim.command('Menu', now); }
      else if (e.code === 'KeyS') { e.preventDefault(); sim.command('Settings', now); }
      else if (e.code === 'KeyC') { e.preventDefault(); sim.command('Overlay', now); }
      else if (e.code === 'Space') { e.preventDefault(); sim.command('Next', now); }
      else if (e.code === 'KeyH') { e.preventDefault(); sim.command('Home', now); }
      else if (e.code === 'KeyR') { e.preventDefault(); sim.rotate(now); }
      else if (e.code === 'KeyA') { e.preventDefault(); toggleAudio(); }
      syncMeta();
    };

    const onKeyUp = (e: KeyboardEvent) => {
      const mapped = KEYMAP[e.code];
      if (mapped) sim.setHeld(mapped, false);
    };

    root.addEventListener('keydown', onKeyDown);
    root.addEventListener('keyup', onKeyUp);

    root.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((btn) => {
      const k = btn.dataset.key as SimKey;
      const down = (ev: Event) => {
        ev.preventDefault();
        root.focus();
        sim.setHeld(k, true);
        sim.key(k, performance.now());
        syncMeta();
      };
      const up = () => sim.setHeld(k, false);
      btn.addEventListener('pointerdown', down);
      btn.addEventListener('pointerup', up);
      btn.addEventListener('pointerleave', up);
      btn.addEventListener('pointercancel', up);
    });

    root.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.focus();
        sim.command(btn.dataset.cmd as SimCommand, performance.now());
        syncMeta();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-scene]').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.focus();
        sim.selectSceneById(btn.dataset.scene!, performance.now());
        syncMeta();
      });
    });

    root.querySelector<HTMLButtonElement>('[data-rotate]')?.addEventListener('click', () => {
      sim.rotate(performance.now());
      syncMeta();
    });

    const toggleAudio = () => {
      sim.settings.audioEnabled = !sim.settings.audioEnabled;
      if (audioBtn) {
        audioBtn.setAttribute('aria-pressed', String(sim.settings.audioEnabled));
        audioBtn.innerHTML = `<kbd>A</kbd> ${sim.settings.audioEnabled ? 'Sound on' : 'Sound off'}`;
      }
    };
    audioBtn?.addEventListener('click', toggleAudio);

    const frame = () => {
      const now = performance.now();
      if (sim.tick(now)) {
        sim.renderToCanvas(ctx2d, 5, 1);
        syncMeta();
      }
      requestAnimationFrame(frame);
    };
    sim.tick(performance.now());
    sim.renderToCanvas(ctx2d, 5, 1);
    syncMeta();
    requestAnimationFrame(frame);
  }
</script>

<style>
  .coriolis-sim {
    margin-block: 36px 8px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: var(--radius-l);
    background: var(--navy);
    color: var(--stone);
    border: 1px solid #2a3a63;
  }
  .coriolis-sim:focus-visible {
    outline: 3px solid var(--led);
    outline-offset: 4px;
  }
  .sim-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 24px;
  }
  .sim-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(94, 234, 140, 0.14);
    color: var(--led);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .sim-head h2 {
    font-size: clamp(24px, 3vw, 32px);
    color: var(--stone);
  }
  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .quick button {
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid #304270;
    background: #101933;
    color: var(--ink-soft-dark);
    font: 600 13px/1 var(--font-body);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  .quick button:hover {
    border-color: var(--led);
    color: var(--stone);
    background: #18264c;
  }
  .sim-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(240px, 1fr);
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 820px) {
    .sim-stage {
      grid-template-columns: 1fr;
    }
  }
  .bezel {
    padding: 14px;
    border-radius: var(--radius-m);
    background: #07090e;
    border: 2px solid #243256;
    box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.7), 0 12px 30px rgba(0, 0, 0, 0.35);
  }
  canvas {
    display: block;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1;
    margin-inline: auto;
    border-radius: 6px;
    image-rendering: pixelated;
    cursor: pointer;
  }
  .sim-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #1b2540;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-soft-dark);
  }
  .remote {
    padding: 20px;
    border-radius: var(--radius-m);
    background: #0e162e;
    border: 1px solid #243256;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .remote-label {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft-dark);
  }
  .dpad {
    display: grid;
    grid-template-columns: repeat(3, 52px);
    grid-template-rows: repeat(3, 48px);
    gap: 6px;
    justify-content: center;
  }
  .dpad button {
    border-radius: 12px;
    border: 1px solid #314373;
    background: #172347;
    color: var(--stone);
    font: 700 15px/1 var(--font-body);
    cursor: pointer;
    user-select: none;
    touch-action: manipulation;
  }
  .dpad button:hover {
    border-color: var(--led);
  }
  .dpad button:active {
    background: var(--led);
    color: var(--navy-deep);
  }
  .dpad .up { grid-column: 2; grid-row: 1; }
  .dpad .left { grid-column: 1; grid-row: 2; }
  .dpad .ok { grid-column: 2; grid-row: 2; background: var(--led); color: var(--navy-deep); border-color: var(--led); }
  .dpad .right { grid-column: 3; grid-row: 2; }
  .dpad .down { grid-column: 2; grid-row: 3; }

  .cmd-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .cmd-grid button {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 10px;
    border-radius: 10px;
    border: 1px solid #2a3a63;
    background: #131e3d;
    color: var(--stone);
    font: 500 13px/1.2 var(--font-body);
    text-align: left;
    cursor: pointer;
  }
  .cmd-grid button:hover {
    border-color: var(--saffron);
  }
  .cmd-grid button[aria-pressed='true'] {
    border-color: var(--led);
    color: var(--led);
  }
  .cmd-grid kbd {
    padding: 2px 6px;
    border-radius: 5px;
    background: #091024;
    border: 1px solid #304270;
    font: 600 11px/1.3 var(--font-body);
    color: var(--ink-soft-dark);
  }
  .remote-hint {
    font-size: 13px;
    color: var(--ink-soft-dark);
    line-height: 1.5;
  }
</style>
