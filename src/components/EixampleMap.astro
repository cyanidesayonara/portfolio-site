---
/*
  A playable 4×3 patch of Eixample. Chamfered blocks with streets between
  them; some blocks are doors into the site. Millie walks the streets with
  her phone-glued human in tow on a leash, a small nod to Path of Leash
  Resistance. Arrow keys or WASD walk her, a tap on a street sends her
  there, and Enter opens the block she is standing next to.

  Without JavaScript (or before it runs) it is a plain map of links.
  Block sizes are in container units: 21.25cqw blocks, 5cqw streets.
*/
type Block = { label?: string; href?: string; bg?: string; ink?: string };

const blocks: Block[] = [
  {},
  { label: 'Leash', href: '/projects/path-of-leash-resistance', bg: 'var(--ink)', ink: 'var(--bg)' },
  {},
  { label: 'stemma', href: '/projects/stemma', bg: 'var(--turquoise)', ink: 'var(--navy-deep)' },
  { label: 'Blog', href: '/blog', bg: 'var(--saffron)', ink: 'var(--navy-deep)' },
  { label: 'Park', href: '/walk', bg: 'var(--leaf)', ink: 'var(--navy-deep)' },
  {},
  { label: 'Coriolis', href: '/projects/coriolis', bg: '#000', ink: 'var(--led)' },
  {},
  { label: 'About', href: '/about', bg: 'var(--magenta)', ink: 'var(--navy-deep)' },
  {},
  { label: 'How I build', href: '/how-i-build', bg: 'var(--surface)', ink: 'var(--ink)' },
];
---

<figure class="map" data-playmap tabindex="0" aria-label="Playable map of the site. Use the arrow keys to walk Millie and Enter to open a block." aria-describedby="map-caption">
  <div class="city">
    <ul class="grid" aria-label="Map of the site">
      {
        blocks.map((b) =>
          b.href ? (
            <li>
              <a class="block door" href={b.href} data-label={b.label} style={`--b:${b.bg};--i:${b.ink}`}>
                {b.label}
              </a>
            </li>
          ) : (
            <li class="block" aria-hidden="true" />
          ),
        )
      }
    </ul>
  </div>
  <canvas aria-hidden="true"></canvas>
  <figcaption id="map-caption" data-caption aria-live="polite">Pick a block to visit.</figcaption>
</figure>

<script>
  type Blk = { cx: number; cy: number; h: number; el: HTMLAnchorElement | null; label: string };
  type Vec = { x: number; y: number };

  const KEYS: Record<string, Vec> = {
    ArrowUp: { x: 0, y: -1 }, KeyW: { x: 0, y: -1 },
    ArrowDown: { x: 0, y: 1 }, KeyS: { x: 0, y: 1 },
    ArrowLeft: { x: -1, y: 0 }, KeyA: { x: -1, y: 0 },
    ArrowRight: { x: 1, y: 0 }, KeyD: { x: 1, y: 0 },
  };

  function init(fig: HTMLElement) {
    const canvas = fig.querySelector('canvas')!;
    const ctx = canvas.getContext('2d');
    const caption = fig.querySelector<HTMLElement>('[data-caption]')!;
    const grid = fig.querySelector<HTMLElement>('.grid')!;
    if (!ctx) return;
    fig.classList.add('live');

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = matchMedia('(pointer: coarse)').matches;

    let W = 0, H = 0, dpr = 1;
    let blocks: Blk[] = [];
    let bounds = { l: 0, t: 0, r: 0, b: 0 };
    let xs: number[] = [], ys: number[] = [];
    let unit = 10; // half a block, in px

    // Positions are kept in px and rescaled when the map resizes.
    const millie = { x: 0, y: 0, heading: 0, moving: false };
    const human = { x: 0, y: 0, heading: 0 };
    const held = new Set<string>();
    let target: Vec | null = null;
    let playing = false;
    let near: Blk | null = null;
    let wander: { i: number; j: number; pi: number; pj: number } | null = null;

    const css = (name: string) => getComputedStyle(fig).getPropertyValue(name).trim();

    function measure() {
      const r = fig.getBoundingClientRect();
      const oldW = W, oldH = H;
      W = r.width;
      H = r.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);

      blocks = [...fig.querySelectorAll<HTMLElement>('.block')].map((el) => {
        const b = el.getBoundingClientRect();
        return {
          cx: b.left - r.left + b.width / 2,
          cy: b.top - r.top + b.height / 2,
          h: b.width / 2,
          el: el instanceof HTMLAnchorElement ? el : null,
          label: el.dataset.label ?? '',
        };
      });
      const g = grid.getBoundingClientRect();
      const pad = g.left - r.left;
      bounds = { l: 0, t: 0, r: W, b: g.bottom - r.top + pad };
      unit = blocks[0]?.h ?? 10;

      const cols = [...new Set(blocks.map((b) => Math.round(b.cx)))].sort((a, b) => a - b);
      const rows = [...new Set(blocks.map((b) => Math.round(b.cy)))].sort((a, b) => a - b);
      const mids = (c: number[], lo: number, hi: number) => [
        (lo + c[0] - unit) / 2,
        ...c.slice(1).map((v, i) => (c[i] + v) / 2),
        (c[c.length - 1] + unit + hi) / 2,
      ];
      xs = mids(cols, bounds.l, bounds.r);
      ys = mids(rows, bounds.t, bounds.b);

      if (oldW && oldH) {
        for (const p of [millie, human]) {
          p.x *= W / oldW;
          p.y *= H / oldH;
        }
        if (target) target = { x: (target.x * W) / oldW, y: (target.y * H) / oldH };
      } else {
        millie.x = xs[1];
        millie.y = ys[1];
        human.x = xs[0];
        human.y = ys[1];
        wander = { i: 1, j: 1, pi: 0, pj: 1 };
      }
    }

    const R = () => Math.max(6, unit * 0.17); // Millie's radius
    const HR = () => Math.max(9, unit * 0.26); // the human's radius
    const LEASH = () => unit * 1.7;

    // Signed distance to a chamfered block (negative inside).
    function blockDist(b: Blk, x: number, y: number) {
      const u = Math.abs(x - b.cx), v = Math.abs(y - b.cy);
      return Math.max(u - b.h, v - b.h, (u + v - 1.56 * b.h) / Math.SQRT2);
    }
    function free(x: number, y: number, r: number) {
      if (x < bounds.l + r || x > bounds.r - r || y < bounds.t + r || y > bounds.b - r) return false;
      return blocks.every((b) => blockDist(b, x, y) > r);
    }
    // Move with sliding: try the full step, then each axis alone.
    function step(p: { x: number; y: number }, dx: number, dy: number, r: number) {
      if (free(p.x + dx, p.y + dy, r)) { p.x += dx; p.y += dy; return true; }
      if (dx && free(p.x + dx, p.y, r)) { p.x += dx; return true; }
      if (dy && free(p.x, p.y + dy, r)) { p.y += dy; return true; }
      return false;
    }

    function input(): Vec | null {
      let x = 0, y = 0;
      for (const k of held) { x += KEYS[k].x; y += KEYS[k].y; }
      if (x || y) { target = null; const l = Math.hypot(x, y); return { x: x / l, y: y / l }; }
      if (target) {
        const dx = target.x - millie.x, dy = target.y - millie.y, l = Math.hypot(dx, dy);
        if (l < 3) { target = null; return null; }
        return { x: dx / l, y: dy / l };
      }
      return null;
    }

    // Before anyone takes the leash, Millie wanders the street grid.
    function autopilot(): Vec | null {
      if (!wander || reduced) return null;
      const tx = xs[wander.i], ty = ys[wander.j];
      const dx = tx - millie.x, dy = ty - millie.y, l = Math.hypot(dx, dy);
      if (l < 2) {
        const opts = [[1, 0], [-1, 0], [0, 1], [0, -1]]
          .map(([a, b]) => [wander!.i + a, wander!.j + b])
          .filter(([i, j]) => i >= 0 && j >= 0 && i < xs.length && j < ys.length)
          .filter(([i, j]) => !(i === wander!.pi && j === wander!.pj));
        const [ni, nj] = opts[Math.floor(Math.random() * opts.length)];
        wander = { i: ni, j: nj, pi: wander.i, pj: wander.j };
        return null;
      }
      return { x: dx / l, y: dy / l };
    }

    function update(dt: number) {
      const dir = playing ? input() : autopilot();
      const speed = unit * (playing ? 2.6 : 1.1);
      millie.moving = !!dir;
      if (dir) {
        step(millie, dir.x * speed * dt, dir.y * speed * dt, R());
        millie.heading = Math.atan2(dir.y, dir.x);
      }

      // The human walks on autopilot after the dog, eyes on the phone.
      // They are four times her weight: at the end of the leash she
      // only drags them a little, and mostly gets held back.
      const L = LEASH();
      let dx = millie.x - human.x, dy = millie.y - human.y, d = Math.hypot(dx, dy);
      if (d > L * 0.7) {
        const hs = unit * (playing ? 1.9 : 0.9) * dt;
        step(human, (dx / d) * hs, (dy / d) * hs, HR());
        human.heading = Math.atan2(dy, dx);
      }
      dx = millie.x - human.x; dy = millie.y - human.y; d = Math.hypot(dx, dy);
      if (d > L) {
        const over = d - L;
        step(human, (dx / d) * over * 0.2, (dy / d) * over * 0.2, HR());
        dx = millie.x - human.x; dy = millie.y - human.y; d = Math.hypot(dx, dy);
        if (d > L) step(millie, (-dx / d) * (d - L), (-dy / d) * (d - L), R());
      }

      // Which door is Millie next to?
      let best: Blk | null = null, bd = Infinity;
      for (const b of blocks) {
        if (!b.el) continue;
        const bdist = blockDist(b, millie.x, millie.y);
        if (bdist < R() + unit * 0.25 && bdist < bd) { best = b; bd = bdist; }
      }
      if (best !== near) {
        near?.el?.classList.remove('near');
        best?.el?.classList.add('near');
        near = best;
        say();
      }
    }

    function say() {
      let text: string;
      if (near && playing) text = coarse ? `Tap ${near.label} to go in.` : `Press Enter to visit ${near.label}.`;
      else if (playing) text = 'Walk Millie up to a block to visit it.';
      else text = coarse ? 'Tap a street to take Millie for a walk.' : 'Click the map, then use the arrow keys or WASD to walk Millie.';
      if (caption.textContent !== text) caption.textContent = text;
    }

    function draw() {
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.clearRect(0, 0, W, H);
      const ink = css('--ink') || '#14203d';
      const r = R(), hr = HR();

      // Leash: sags when slack, straight when taut.
      const hx = human.x + Math.cos(human.heading) * hr * 0.6;
      const hy = human.y + Math.sin(human.heading) * hr * 0.6;
      const dx = millie.x - hx, dy = millie.y - hy, d = Math.hypot(dx, dy) || 1;
      const slack = Math.max(0, LEASH() - d);
      ctx!.strokeStyle = '#e5487a';
      ctx!.lineWidth = Math.max(1.5, unit * 0.05);
      ctx!.lineCap = 'round';
      ctx!.beginPath();
      ctx!.moveTo(hx, hy);
      ctx!.quadraticCurveTo((hx + millie.x) / 2 + (-dy / d) * slack * 0.35, (hy + millie.y) / 2 + (dx / d) * slack * 0.35 + slack * 0.25, millie.x, millie.y);
      ctx!.stroke();

      // The human, from above: shoulders, head, and the phone's glow.
      ctx!.save();
      ctx!.translate(human.x, human.y);
      ctx!.rotate(human.heading);
      ctx!.fillStyle = '#1fc9b7';
      ctx!.beginPath();
      ctx!.ellipse(0, 0, hr * 0.7, hr, 0, 0, Math.PI * 2);
      ctx!.fill();
      ctx!.fillStyle = '#5b3a29';
      ctx!.beginPath();
      ctx!.arc(-hr * 0.05, 0, hr * 0.48, 0, Math.PI * 2);
      ctx!.fill();
      ctx!.fillStyle = '#fff6d8';
      ctx!.shadowColor = '#ffffff';
      ctx!.shadowBlur = 6;
      ctx!.fillRect(hr * 0.55, -hr * 0.22, hr * 0.32, hr * 0.44);
      ctx!.restore();

      // Millie: body, head, ears, tail and a saffron collar.
      const t = performance.now() / 1000;
      const wag = millie.moving ? Math.sin(t * 18) * 0.5 : Math.sin(t * 4) * 0.25;
      ctx!.save();
      ctx!.translate(millie.x, millie.y);
      ctx!.rotate(millie.heading);
      ctx!.fillStyle = ink;
      ctx!.strokeStyle = ink;
      ctx!.lineWidth = r * 0.35;
      ctx!.beginPath();
      ctx!.moveTo(-r * 1.1, 0);
      ctx!.lineTo(-r * 1.1 - Math.cos(wag) * r * 0.9, Math.sin(wag) * r * 0.9);
      ctx!.stroke();
      ctx!.beginPath();
      ctx!.ellipse(-r * 0.15, 0, r * 1.15, r * 0.62, 0, 0, Math.PI * 2);
      ctx!.fill();
      ctx!.beginPath();
      ctx!.arc(r * 0.95, 0, r * 0.55, 0, Math.PI * 2);
      ctx!.fill();
      ctx!.beginPath();
      ctx!.ellipse(r * 0.8, -r * 0.5, r * 0.3, r * 0.18, -0.6, 0, Math.PI * 2);
      ctx!.ellipse(r * 0.8, r * 0.5, r * 0.3, r * 0.18, 0.6, 0, Math.PI * 2);
      ctx!.fill();
      ctx!.strokeStyle = '#ffb020';
      ctx!.lineWidth = r * 0.28;
      ctx!.beginPath();
      ctx!.moveTo(r * 0.45, -r * 0.45);
      ctx!.lineTo(r * 0.45, r * 0.45);
      ctx!.stroke();
      ctx!.restore();
    }

    let last = 0, raf = 0, visible = true;
    function frame(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000 || 0);
      last = now;
      update(dt);
      draw();
      raf = visible ? requestAnimationFrame(frame) : 0;
    }
    function start() {
      if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); }
    }

    function takeLeash() {
      if (!playing) { playing = true; wander = null; say(); }
    }

    fig.addEventListener('keydown', (e) => {
      if (e.code in KEYS) {
        e.preventDefault();
        takeLeash();
        held.add(e.code);
      } else if ((e.key === 'Enter' || e.key === ' ') && near?.el && e.target === fig) {
        e.preventDefault();
        near.el.click();
      } else if (e.key === 'Escape') {
        fig.blur();
      }
    });
    fig.addEventListener('keyup', (e) => held.delete(e.code));
    fig.addEventListener('blur', () => held.clear());
    fig.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest('a')) return;
      const r = fig.getBoundingClientRect();
      const p = { x: e.clientX - r.left, y: e.clientY - r.top };
      if (p.y > bounds.b) return;
      fig.focus({ preventScroll: true });
      takeLeash();
      target = p;
    });

    new ResizeObserver(() => { measure(); draw(); }).observe(fig);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start();
    }).observe(fig);

    measure();
    say();
    start();
  }

  document.querySelectorAll<HTMLElement>('[data-playmap]').forEach(init);
</script>

<style>
  .map {
    position: relative;
    margin: 0;
    padding: clamp(16px, 3vw, 28px);
    background: var(--bg-sunk);
    border-radius: var(--radius-l);
  }
  .map:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--radius-l);
  }
  .map.live {
    cursor: crosshair;
  }
  .city {
    position: relative;
    container-type: inline-size;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 5cqw;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .block {
    display: flex;
    aspect-ratio: 1 / 1;
    width: 100%;
    background: var(--b, var(--block));
    color: var(--i, var(--ink));
    clip-path: polygon(22% 0, 78% 0, 100% 22%, 100% 78%, 78% 100%, 22% 100%, 0 78%, 0 22%);
  }
  li:has(> .door) {
    display: flex;
  }
  .door {
    align-items: center;
    justify-content: center;
    padding: 8px;
    text-align: center;
    font-weight: 700;
    font-size: clamp(11px, 3.2cqw, 16px);
    line-height: 1.15;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .door:hover,
  .door:global(.near) {
    color: var(--i);
    transform: scale(1.06);
  }
  .door:global(.near) {
    box-shadow: inset 0 0 0 4px var(--saffron);
  }
  .door:focus-visible {
    outline: none;
    transform: scale(1.06);
    box-shadow: inset 0 0 0 4px var(--focus);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  figcaption {
    margin-top: 16px;
    min-height: 1.6em;
    font-size: 14px;
    color: var(--ink-2);
    text-align: center;
  }
</style>
