---
import { LOCALES, LOCALE_LABELS, LOCALE_NAMES, localePath, stripLocale, switchLocalePath, type Locale } from '../i18n/utils';
import { getUi } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const ui = getUi(locale);

const nav = [
  { base: '/projects', label: ui.header.nav.projects },
  { base: '/how-i-build', label: ui.header.nav.howIBuild },
  { base: '/blog', label: ui.header.nav.blog },
  { base: '/about', label: ui.header.nav.about },
];
const path = stripLocale(Astro.url.pathname);
const isCurrent = (base: string) => path === base || path.startsWith(base + '/');
---

<header class="site-header wrap">
  <a class="brand" href={localePath(locale, '/')}>
    <img src="/img/avatar.png" alt="" width="40" height="40" />
    <span>Santtu Nykänen</span>
  </a>
  <nav aria-label={ui.header.navAria}>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={localePath(locale, item.base)} aria-current={isCurrent(item.base) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="actions">
    <div class="lang-switch" role="group" aria-label={ui.header.langSwitcherAria}>
      {
        LOCALES.map((loc) => (
          <a
            href={switchLocalePath(Astro.url.pathname, loc)}
            hreflang={loc}
            lang={loc}
            title={LOCALE_NAMES[loc]}
            aria-current={loc === locale ? 'true' : undefined}
          >
            {LOCALE_LABELS[loc]}
          </a>
        ))
      }
    </div>
    <button class="theme-toggle" type="button" aria-label={ui.header.themeToggleAria}>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"></path>
      </svg>
    </button>
    <a class="btn btn-primary walk" href={localePath(locale, '/walk')}>{ui.header.walkCta}</a>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    min-height: 44px;
  }
  .brand img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--bg-sunk);
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
    border-radius: 10px;
  }
  nav a[aria-current='page'] {
    background: var(--accent);
    color: var(--on-accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 10px;
    background: var(--bg-sunk);
  }
  .lang-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0 8px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-2);
  }
  .lang-switch a:hover {
    color: var(--ink);
  }
  .lang-switch a[aria-current='true'] {
    background: var(--accent);
    color: var(--on-accent);
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--bg-sunk);
  }
  .walk {
    min-height: 44px;
    font-size: 15px;
    padding: 0 18px;
  }
  @media (max-width: 520px) {
    .site-header {
      gap: 8px;
      padding-block: 14px;
    }
    .brand {
      gap: 7px;
      font-size: 15px;
      min-height: 38px;
    }
    .brand img {
      width: 28px;
      height: 28px;
    }
    .actions {
      gap: 4px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    .lang-switch {
      padding: 2px;
    }
    .lang-switch a {
      min-height: 30px;
      padding: 0 6px;
      font-size: 11px;
    }
    .theme-toggle {
      width: 36px;
      height: 36px;
    }
    .walk {
      min-height: 36px;
      padding: 0 10px;
      font-size: 12.5px;
      white-space: nowrap;
    }
    nav a {
      font-size: 13.5px;
      padding: 0 6px;
      min-height: 38px;
    }
  }
  @media (max-width: 720px) {
    nav {
      order: 3;
      width: 100%;
    }
    nav ul {
      justify-content: space-between;
    }
    nav a {
      padding: 0 8px;
    }
  }
</style>
