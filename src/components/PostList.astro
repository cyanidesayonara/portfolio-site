---
import type { LocalizedEntry } from '../i18n/content';
import { BCP47, localePath, type Locale } from '../i18n/utils';
import { getUi } from '../i18n/ui';

interface Props {
  posts: LocalizedEntry<'blog'>[];
  locale?: Locale;
}
const { posts, locale = 'en' } = Astro.props;
const ui = getUi(locale);
const fmt = new Intl.DateTimeFormat(BCP47[locale], { day: 'numeric', month: 'short', year: 'numeric' });
---

<ul class="posts">
  {
    posts.map((item) => {
      const post = item.entry;
      return (
        <li>
          <a href={localePath(locale, `/blog/${item.slug}`)}>
            <span class="t">
              {post.data.draft && <span class="draft">{ui.common.draftBadge}</span>}
              {item.isFallback && <span class="draft en-only" title={ui.common.englishFallbackNotice}>{ui.common.englishOnlyBadge}</span>}
              {post.data.title}
            </span>
            <span class="d">{post.data.description}</span>
          </a>
          <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
        </li>
      );
    })
  }
</ul>

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }
  li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  a {
    flex: 1 1 420px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
  }
  .t {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.2;
  }
  a:hover .t {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .draft {
    display: inline-block;
    margin-right: 10px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--magenta);
    color: var(--navy-deep);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    vertical-align: middle;
  }
  .draft.en-only {
    background: var(--bg-sunk);
    color: var(--ink-2);
  }
  .d {
    color: var(--ink-2);
  }
  time {
    font-size: 14px;
    color: var(--ink-2);
    white-space: nowrap;
  }
</style>
