---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'feature' | 'card' | 'compact';
  headingLevel?: 'h2' | 'h3';
}

const { project, variant = 'card', headingLevel = 'h3' } = Astro.props;
const p = project.data;
const href = `/projects/${project.id}`;
const H = headingLevel;
---

<a class:list={['project', variant]} href={href}>
  <div class:list={['cover', { dark: p.coverDark }]}>
    <img src={p.cover} alt={p.coverAlt} loading="lazy" decoding="async" style={`object-position: ${p.coverPosition}`} />
  </div>
  <div class="body">
    <span class="kind" style={`--k: var(--${p.color})`}>{p.kind}</span>
    <H class="title">{p.title}</H>
    <p class="tagline">{p.tagline}</p>
    {variant !== 'compact' && <p class="stack">{p.stack.join(' · ')}</p>}
  </div>
</a>

<style>
  .project {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-radius: var(--radius-l);
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .project:hover {
    color: var(--ink);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .project:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }
  .cover {
    aspect-ratio: 16 / 10;
    background: var(--bg-sunk);
  }
  .cover.dark {
    background: #000;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 28px 28px;
  }
  .kind {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--k);
    color: var(--navy-deep);
    font-size: 13px;
    font-weight: 600;
  }
  .title {
    font-size: 28px;
  }
  .tagline {
    color: var(--ink-2);
  }
  .stack {
    font-size: 14px;
    color: var(--ink-2);
  }

  /* Wide, navy, image right: the headline project */
  .feature {
    flex-direction: row-reverse;
    flex-wrap: wrap;
    background: var(--feature-bg);
    color: var(--feature-ink);
  }
  .feature:hover {
    color: var(--feature-ink);
  }
  .feature .cover {
    flex: 3 1 480px;
    min-width: 0;
    aspect-ratio: 16 / 9;
  }
  .feature .body {
    flex: 2 1 320px;
    justify-content: center;
    padding: clamp(28px, 4vw, 44px);
    gap: 16px;
  }
  .feature .title {
    font-size: clamp(32px, 4vw, 44px);
  }
  .feature .tagline,
  .feature .stack {
    color: var(--feature-ink-2);
    font-size: 17px;
  }

  .compact .cover {
    aspect-ratio: 4 / 3;
  }
  .compact .body {
    padding: 18px 20px 22px;
    gap: 8px;
  }
  .compact .title {
    font-size: 22px;
  }
  .compact .tagline {
    font-size: 15px;
  }
</style>
