---
import type { LocalizedEntry } from '../i18n/content';
import { localePath, type Locale } from '../i18n/utils';
import { getUi } from '../i18n/ui';

interface Props {
  prev: LocalizedEntry<'projects'>;
  next: LocalizedEntry<'projects'>;
  locale?: Locale;
}
const { prev, next, locale = 'en' } = Astro.props;
const ui = getUi(locale);
---

<nav class="pager" aria-label={ui.common.moreProjectsAria}>
  <a class="prev" href={localePath(locale, `/projects/${prev.slug}`)} rel="prev">
    <span class="dir">{ui.common.previousProject}</span>
    <span class="name">{prev.entry.data.title}</span>
  </a>
  <a class="next" href={localePath(locale, `/projects/${next.slug}`)} rel="next">
    <span class="dir">{ui.common.nextProject}</span>
    <span class="name">{next.entry.data.title}</span>
  </a>
</nav>

<style>
  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
    padding-top: 32px;
    border-top: 2px solid var(--ink);
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px 28px;
    background: var(--surface);
    border-radius: var(--radius-m);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  a:hover {
    color: var(--ink);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  .next {
    text-align: right;
  }
  .dir {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .prev .dir::before {
    content: '← ';
  }
  .next .dir::after {
    content: ' →';
  }
  .name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(22px, 3vw, 30px);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
</style>
