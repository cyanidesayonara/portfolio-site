---
/*
  The home page's playable street, a nod to Path of Leash Resistance.
  The game lives in src/scripts/street/ (world.ts: layout and the static
  layer; game.ts: simulation, NPCs, input and drawing).

  The row of links under the street is the real navigation: it works
  without JavaScript, and it lights up when Millie reaches a shop.
*/
import { localePath, type Locale } from '../i18n/utils';
import { getUi } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const ui = getUi(locale).streetMap;
const podLabels = JSON.stringify(getUi(locale).podPlayer);

const STOPS = ui.stops.map((s) => ({
  id: s.id,
  label: s.label,
  short: s.short,
  kind: s.kind,
  href: localePath(locale, s.path),
  color: s.color,
  ink: s.ink,
}));
const CORE_KEYS = ui.keys.filter((k) => ['W', 'Space', 'E'].includes(k.keys[0]));
const EXTRA_KEYS = ui.keys.filter((k) => !['W', 'Space', 'E'].includes(k.keys[0]));
---

<figure
  class="street"
  data-street
  data-stops={JSON.stringify(STOPS)}
  data-try-booth={ui.tryBooth}
  data-close-booth={ui.closeBooth}
  data-open-page={ui.openPage}
  tabindex="0"
  aria-label={ui.ariaLabel}
  aria-describedby="street-caption"
>
  <div class="static-street">
    <svg class="static-skyline" viewBox="0 0 640 108" width="640" height="108" aria-hidden="true">
      <rect width="640" height="68" fill="#14203d" />
      <rect y="68" width="640" height="24" fill="#e4dbca" />
      <rect y="92" width="640" height="16" fill="#4a4f5c" />
      <rect x="20" y="16" width="84" height="52" rx="4" fill="#212d54" />
      <rect x="20" y="16" width="84" height="8" fill="#d94ca6" />
      <rect x="114" y="12" width="92" height="56" rx="4" fill="#f4f1ea" />
      <rect x="114" y="12" width="92" height="8" fill="#f0c44d" />
      <rect x="216" y="14" width="102" height="54" rx="4" fill="#f4f1ea" />
      <rect x="216" y="14" width="102" height="8" fill="#ffb020" />
      <rect x="328" y="16" width="88" height="52" rx="4" fill="#f4f1ea" />
      <rect x="328" y="16" width="88" height="8" fill="#1fc9b7" />
      <rect x="426" y="14" width="92" height="54" rx="4" fill="#0b0b0b" />
      <rect x="426" y="14" width="92" height="8" fill="#5eea8c" />
      <rect x="528" y="18" width="92" height="50" rx="4" fill="#f4f1ea" />
      <rect x="528" y="18" width="92" height="8" fill="#e5487a" />
      <ellipse cx="268" cy="80" rx="10" ry="6" fill="#1b1b1f" />
      <circle cx="280" cy="79" r="5" fill="#1b1b1f" />
      <line x1="258" y1="80" x2="236" y2="76" stroke="#d9403a" stroke-width="2.5" stroke-linecap="round" />
      <circle cx="233" cy="76" r="6" fill="#1fc9b7" />
    </svg>
    <div class="static-copy">
      <h3>{ui.noscriptTitle}</h3>
      <p>{ui.noscriptNote}</p>
    </div>
  </div>
  <div class="stage">
    <canvas aria-hidden="true"></canvas>
    <aside class="retro-booth" data-retro-booth data-pod-labels={podLabels} hidden aria-live="polite">
      <header class="rb-head">
        <b data-retro-title>Eat Prey Nap</b>
        <div class="rb-actions">
          <a class="rb-link" data-retro-link href="#">{ui.openPage}</a>
          <button type="button" class="rb-close" data-retro-close aria-label={ui.closeBooth}>×</button>
        </div>
      </header>
      <div class="rb-body">
        <canvas class="rb-screen" data-retro-canvas width="160" height="100"></canvas>
        <div class="rb-ctrl" data-retro-controls></div>
      </div>
    </aside>
  </div>
  <figcaption>
    <div class="bar">
      <p id="street-caption" class="caption" data-caption aria-live="polite">{ui.defaultCaption}</p>
      <div class="tools">
        <button
          class="sound"
          type="button"
          data-sound
          aria-pressed="false"
          data-label-on={ui.soundOn}
          data-label-off={ui.soundOff}
        >{ui.soundOff}</button>
        <button class="sound" type="button" data-restart>{ui.restart}</button>
        <button class="sound" type="button" data-fs="window" aria-pressed="false" title={ui.fillWindowTitle}>{ui.fillWindow}</button>
        <button class="sound" type="button" data-fs="screen" aria-pressed="false" title={ui.fullscreenTitle}>{ui.fullscreen}</button>
      </div>
    </div>
    <div class="keys-row">
      <ul class="keys" aria-label={ui.controlsAria}>
        {
          CORE_KEYS.map((k) => (
            <li>
              <span class="caps">
                {k.keys.map((key) => (
                  <kbd class:list={{ wide: key.length > 1 }}>{key}</kbd>
                ))}
              </span>
              <span class="what">{k.label}</span>
            </li>
          ))
        }
      </ul>
      <details class="more-keys">
        <summary>{ui.moreControls}</summary>
        <ul class="keys extra-keys">
          {
            EXTRA_KEYS.map((k) => (
              <li>
                <span class="caps">
                  {k.keys.map((key) => (
                    <kbd class:list={{ wide: key.length > 1 }}>{key}</kbd>
                  ))}
                </span>
                <span class="what">{k.label}</span>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
    <ul class="stops" aria-label={ui.stopsAria}>
      {
        STOPS.map((s) => (
          <li data-stop-item={s.id}>
            <a href={s.href} data-stop={s.id} style={`--c:${s.color};--i:${s.ink}`}>
              <span class="stop-name">{s.short}</span>
              {s.kind && <span class="stop-kind">{s.kind}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </figcaption>
</figure>

<script>
  import { startStreet } from '../scripts/street/game';

  const fig = document.querySelector<HTMLElement>('[data-street]');
  if (fig) startStreet(fig, JSON.parse(fig.dataset.stops ?? '[]'));
</script>

<style>
  .street {
    margin: 0;
    border-radius: var(--radius-l);
    background: var(--bg-sunk);
    overflow: hidden;
  }
  .street:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }
  .stage {
    position: relative;
    display: none;
  }
  .street:global(.live) .stage {
    display: block;
  }
  canvas {
    display: block;
    width: 100%;
    /* Tall enough for both sides of the road, closer to the 3D walk's window. */
    height: clamp(400px, min(46vw, 66vh), 600px);
    cursor: pointer;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  /* Fullscreen: the real thing where the browser allows it, otherwise
     the street fills the window (iPhone Safari). */
  .street:fullscreen,
  .street:global(.immersive) {
    display: flex;
    flex-direction: column;
    border-radius: 0;
    background: var(--bg);
  }
  .street:global(.immersive) {
    /* Sized to the visible viewport (--vv-*, set by trackVisibleViewport) so the
       touch controls at the bottom are never pushed off-screen. */
    position: fixed;
    top: var(--vv-top, 0px);
    left: 0;
    right: 0;
    height: var(--vv-h, 100dvh);
    padding-bottom: env(safe-area-inset-bottom);
    z-index: 1000;
  }
  .street:fullscreen .stage,
  .street:global(.immersive) .stage {
    flex: 1;
    min-height: 0;
  }
  .street:fullscreen canvas,
  .street:global(.immersive) canvas {
    height: 100%;
    touch-action: none;
  }
  .street:fullscreen figcaption,
  .street:global(.immersive) figcaption {
    padding-block: 10px 12px;
  }
  /* Once the game runs, the stops are for discovering on the street (or in
     the site's own nav). The links stay in the page for screen readers and
     for the game, which follows them; without JavaScript they show. */
  .street:global(.live) .stops {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 520px) {
    .tools { gap: 6px; }
    .sound { padding: 0 11px; font-size: 13px; }
  }
  /* Keycaps for the controls: shown once the game runs, on keyboards only. */
  .keys-row {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    padding: 12px 0 0;
    border-top: 1px solid var(--line);
  }
  .street:global(.live) .keys-row {
    display: flex;
  }
  @media (pointer: coarse) {
    .street:global(.live) .keys-row {
      display: none;
    }
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .more-keys {
    font-size: 13px;
    color: var(--ink-2);
  }
  .more-keys[open] {
    width: 100%;
  }
  .more-keys summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--ink);
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 11px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .more-keys summary::-webkit-details-marker { display: none; }
  .more-keys summary::after { content: '+'; font-weight: 800; }
  .more-keys[open] summary::after { content: '-'; }
  .extra-keys {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
  }
  .keys li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .caps {
    display: inline-flex;
    gap: 3px;
  }
  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 6px;
    border: 1px solid var(--line);
    border-bottom-width: 3px;
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }
  kbd.wide {
    padding: 0 8px;
    font-size: 10px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .what {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .street:fullscreen .keys,
  .street:global(.immersive) .keys {
    padding-top: 8px;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .sound {
    display: none;
    min-height: 36px;
    padding: 0 14px;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .street:global(.live) .sound {
    display: inline-flex;
    align-items: center;
  }
  .street:global(.live) .sound[hidden] { display: none; }
  .sound[aria-pressed='true'] {
    background: var(--saffron);
    border-color: var(--saffron);
    color: var(--navy-deep);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px clamp(16px, 3vw, 24px) 20px;
  }
  .caption {
    min-height: 1.6em;
    font-size: 14px;
    color: var(--ink-2);
  }
  .stops {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stops a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 2px solid var(--line);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .stop-kind {
    display: none;
  }
  .stops a:hover,
  .stops a:global(.near) {
    background: var(--c);
    border-color: var(--c);
    color: var(--i);
  }
  .stops a:global(.near) {
    transform: translateY(-2px);
  }
  .static-street {
    display: none;
  }
  :global(html:not(.js)) .static-street {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) 1fr;
    gap: 18px;
    align-items: center;
    padding: clamp(16px, 3vw, 24px);
    background: var(--feature-bg);
    color: var(--feature-ink);
  }
  .static-skyline {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-s);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .static-copy h3 {
    margin: 0 0 6px;
    font: 800 clamp(20px, 2.8vw, 26px)/1.15 var(--font-display);
    color: var(--feature-ink);
  }
  .static-copy p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--feature-ink-2);
  }
  :global(html:not(.js)) .bar {
    display: none;
  }
  :global(html:not(.js)) .stops {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
    gap: 10px;
  }
  :global(html:not(.js)) [data-stop-item='station'],
  :global(html:not(.js)) [data-stop-item='metro'],
  :global(html:not(.js)) [data-stop-item='park'] {
    display: none;
  }
  :global(html:not(.js)) .stops a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
    width: 100%;
    min-height: 54px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    border-left: 5px solid var(--c);
    background: var(--surface);
    color: var(--ink);
  }
  :global(html:not(.js)) .stops a:hover {
    background: var(--c);
    border-color: var(--c);
    color: var(--i);
  }
  :global(html:not(.js)) .stops a:hover .stop-kind {
    color: var(--i);
    opacity: 0.85;
  }
  :global(html:not(.js)) .stop-kind {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-2);
  }
  @media (max-width: 720px) {
    :global(html:not(.js)) .static-street {
      grid-template-columns: 1fr;
    }
  }

  .retro-booth {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    max-width: 480px;
    margin: 0 auto;
    padding: 8px 10px;
    background: #0f162b;
    color: #f4f1ea;
    border: 3px solid #f4f1ea;
    box-shadow: 4px 4px 0 #070b18;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    z-index: 6;
  }
  .retro-booth[hidden] { display: none; }
  .rb-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }
  .rb-head b {
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .rb-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .rb-link {
    padding: 3px 8px;
    border: 2px solid #5eea8c;
    color: #5eea8c;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
  }
  .rb-close {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 2px solid #f4f1ea;
    background: #1a284d;
    color: #f4f1ea;
    font: 800 14px/1 ui-monospace, monospace;
    cursor: pointer;
  }
  .rb-body {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: center;
  }
  .rb-screen {
    display: block;
    width: 160px;
    height: 100px;
    image-rendering: pixelated;
    border: 2px solid #3c4f82;
    background: #070b18;
    cursor: pointer;
  }
  .rb-ctrl {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
  }
  .rb-ctrl :global(button) {
    padding: 4px 8px;
    border: 2px solid #3c4f82;
    background: #1a284d;
    color: #f4f1ea;
    font: 700 11px ui-monospace, monospace;
    cursor: pointer;
  }
  .rb-ctrl :global(button[aria-pressed='true']) {
    border-color: #f0c44d;
    background: #f0c44d;
    color: #0b1430;
  }
  .rb-ctrl :global(span.rb-stat) {
    font-size: 11px;
    color: #b7c2df;
    width: 100%;
  }
  /* dopepod: the shared podcast controls, in pixels. */
  .rb-ctrl:global(.pod) { --pod: #d94ca6; display: grid; gap: 5px; min-width: 0; }
  .rb-ctrl :global(.pod-now) { margin: 0; font-size: 11px; color: #b7c2df; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rb-ctrl :global(.pod-now.bad) { color: #ffb3a7; white-space: normal; }
  .rb-ctrl :global(.pod-transport),
  .rb-ctrl :global(.pod-shows) { display: flex; flex-wrap: wrap; gap: 5px; }
  .rb-ctrl :global(.pod-show) { max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rb-ctrl :global(.pod-show[aria-pressed='true']),
  .rb-ctrl :global(.play[aria-pressed='true']) { border-color: var(--pod); background: var(--pod); color: #0b1430; }
  .rb-ctrl :global(button:disabled) { opacity: 0.45; cursor: default; }
  .rb-ctrl :global(button:focus-visible),
  .rb-ctrl :global(a:focus-visible),
  .rb-ctrl :global(input:focus-visible) { outline: 2px solid #ffb020; outline-offset: 2px; }
  .rb-ctrl :global(.pod-seek) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; }
  .rb-ctrl :global(.pod-range) {
    appearance: none;
    width: 100%;
    height: 14px;
    margin: 0;
    border: 2px solid #3c4f82;
    background: #070b18;
    cursor: pointer;
  }
  .rb-ctrl :global(.pod-range::-webkit-slider-thumb) { appearance: none; width: 10px; height: 14px; background: var(--pod); }
  .rb-ctrl :global(.pod-range::-moz-range-thumb) { width: 10px; height: 14px; border: 0; border-radius: 0; background: var(--pod); }
  .rb-ctrl :global(.pod-clock) { font-size: 10px; color: #b7c2df; }
  .rb-ctrl :global(.pod-open) { justify-self: start; font-size: 11px; font-weight: 700; color: #5eea8c; }
  @media (pointer: coarse) {
    .retro-booth:has(.pod) { max-height: calc(100% - 12px); overflow: auto; }
    .retro-booth:has(.pod) .rb-close { width: 44px; height: 44px; }
    .retro-booth:has(.pod) .rb-link { display: inline-flex; align-items: center; min-height: 44px; }
    .rb-ctrl :global(.pod-transport button),
    .rb-ctrl :global(.pod-show) { min-height: 44px; min-width: 44px; }
    .rb-ctrl :global(.pod-range) { height: 44px; }
    .rb-ctrl :global(.pod-range::-webkit-slider-thumb) { width: 16px; height: 40px; }
    .rb-ctrl :global(.pod-range::-moz-range-thumb) { width: 16px; height: 40px; }
    .rb-ctrl :global(.pod-open) { display: inline-flex; align-items: center; min-height: 44px; }
  }
  @media (max-width: 600px) {
    .retro-booth { left: 6px; right: 6px; bottom: 6px; max-height: 44%; padding: 6px 8px; }
    .retro-booth:has(.pod) { max-height: calc(100% - 12px); overflow: auto; }
    .retro-booth:has(.pod) .rb-body { grid-template-columns: minmax(0, 1fr); }
    .retro-booth:has(.pod) .rb-screen { display: none; }

    .rb-body { gap: 8px; }
    .rb-screen { width: 128px; height: 80px; }
    .rb-ctrl :global(button) { padding: 3px 6px; font-size: 10px; }
  }
</style>
