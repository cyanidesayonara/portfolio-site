---
/*
  The home page's playable street, a nod to Path of Leash Resistance.
  The game lives in src/scripts/street/ (world.ts: layout and the static
  layer; game.ts: simulation, NPCs, input and drawing).

  The row of links under the street is the real navigation: it works
  without JavaScript, and it lights up when Millie reaches a shop.
*/
const STOPS = [
  { id: 'leash', label: 'Path of Leash Resistance', short: 'Leash', kind: 'Game', href: '/projects/path-of-leash-resistance', color: '#ffb020', ink: '#0b1430' },
  { id: 'stemma', label: 'stemma', short: 'stemma', kind: 'Music app', href: '/projects/stemma', color: '#1fc9b7', ink: '#0b1430' },
  { id: 'coriolis', label: 'Coriolis', short: 'Coriolis', kind: 'LED wall', href: '/projects/coriolis', color: '#0b0b0b', ink: '#5eea8c' },
  { id: 'blog', label: 'Blog', short: 'Blog', kind: 'Kiosk', href: '/blog', color: '#e5487a', ink: '#0b1430' },
  { id: 'how', label: 'How I build', short: 'How I build', kind: 'Workshop', href: '/how-i-build', color: '#14203d', ink: '#f4f1ea' },
  { id: 'about', label: 'About', short: 'About', kind: 'Café', href: '/about', color: '#8bcb3c', ink: '#0b1430' },
  { id: 'park', label: 'The park', short: 'Park', kind: 'Coming soon', href: '/walk', color: '#5f9e4a', ink: '#0b1430' },
];
---

<figure class="street" data-street data-stops={JSON.stringify(STOPS)} tabindex="0" aria-label="Playable street. Arrow keys walk Millie, Shift sprints, E pees, Space barks and Enter goes into a shop." aria-describedby="street-caption">
  <div class="stage">
    <canvas aria-hidden="true"></canvas>
    <p class="hint" data-hint aria-hidden="true"></p>
  </div>
  <figcaption>
    <p id="street-caption" class="caption" data-caption aria-live="polite">Pick a stop.</p>
    <ul class="stops" aria-label="Stops on the street">
      {
        STOPS.map((s) => (
          <li>
            <a href={s.href} data-stop={s.id} style={`--c:${s.color};--i:${s.ink}`}>
              {s.short}
            </a>
          </li>
        ))
      }
    </ul>
  </figcaption>
</figure>

<script>
  import { startStreet } from '../scripts/street/game';

  const fig = document.querySelector<HTMLElement>('[data-street]');
  if (fig) startStreet(fig, JSON.parse(fig.dataset.stops ?? '[]'));
</script>

<style>
  .street {
    margin: 0;
    border-radius: var(--radius-l);
    background: var(--bg-sunk);
    overflow: hidden;
  }
  .street:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }
  .stage {
    position: relative;
    display: none;
  }
  .street:global(.live) .stage {
    display: block;
  }
  canvas {
    display: block;
    width: 100%;
    height: clamp(300px, 34vw, 420px);
    cursor: pointer;
    touch-action: manipulation;
  }
  .hint {
    position: absolute;
    left: 50%;
    top: 12px;
    margin: 0;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--navy-deep);
    color: var(--stone);
    font-size: 14px;
    font-weight: 600;
    transform: translate(-50%, -6px);
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }
  .hint:global(.show) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px clamp(16px, 3vw, 24px) 20px;
  }
  .caption {
    min-height: 1.6em;
    font-size: 14px;
    color: var(--ink-2);
  }
  .stops {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stops a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 2px solid var(--line);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .stops a:hover,
  .stops a:global(.near) {
    background: var(--c);
    border-color: var(--c);
    color: var(--i);
  }
  .stops a:global(.near) {
    transform: translateY(-2px);
  }
</style>
