---
/*
  The home page's playable street, a nod to Path of Leash Resistance.
  The game lives in src/scripts/street/ (world.ts: layout and the static
  layer; game.ts: simulation, NPCs, input and drawing).

  The row of links under the street is the real navigation: it works
  without JavaScript, and it lights up when Millie reaches a shop.
*/
import { localePath, type Locale } from '../i18n/utils';
import { getUi } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const ui = getUi(locale).streetMap;

const STOPS = ui.stops.map((s) => ({
  id: s.id,
  label: s.label,
  short: s.short,
  kind: s.kind,
  href: localePath(locale, s.path),
  color: s.color,
  ink: s.ink,
}));
const KEYS = ui.keys;
---

<figure
  class="street"
  data-street
  data-stops={JSON.stringify(STOPS)}
  data-try-booth={ui.tryBooth}
  data-close-booth={ui.closeBooth}
  data-open-page={ui.openPage}
  tabindex="0"
  aria-label={ui.ariaLabel}
  aria-describedby="street-caption"
>
  <div class="stage">
    <canvas aria-hidden="true"></canvas>
    <aside class="retro-booth" data-retro-booth hidden aria-live="polite">
      <header class="rb-head">
        <b data-retro-title>Eat Prey Nap</b>
        <div class="rb-actions">
          <a class="rb-link" data-retro-link href="#">{ui.openPage}</a>
          <button type="button" class="rb-close" data-retro-close aria-label={ui.closeBooth}>×</button>
        </div>
      </header>
      <div class="rb-body">
        <canvas class="rb-screen" data-retro-canvas width="160" height="100"></canvas>
        <div class="rb-ctrl" data-retro-controls></div>
      </div>
    </aside>
  </div>
  <figcaption>
    <div class="bar">
      <p id="street-caption" class="caption" data-caption aria-live="polite">{ui.defaultCaption}</p>
      <div class="tools">
        <button
          class="sound"
          type="button"
          data-sound
          aria-pressed="false"
          data-label-on={ui.soundOn}
          data-label-off={ui.soundOff}
        >{ui.soundOff}</button>
        <button class="sound" type="button" data-restart>{ui.restart}</button>
        <button class="sound" type="button" data-fs="window" aria-pressed="false" title={ui.fillWindowTitle}>{ui.fillWindow}</button>
        <button class="sound" type="button" data-fs="screen" aria-pressed="false" title={ui.fullscreenTitle}>{ui.fullscreen}</button>
      </div>
    </div>
    <ul class="keys" aria-label={ui.controlsAria}>
      {
        KEYS.map((k) => (
          <li>
            <span class="caps">
              {k.keys.map((key) => (
                <kbd class:list={{ wide: key.length > 1 }}>{key}</kbd>
              ))}
            </span>
            <span class="what">{k.label}</span>
          </li>
        ))
      }
    </ul>
    <ul class="stops" aria-label={ui.stopsAria}>
      {
        STOPS.map((s) => (
          <li>
            <a href={s.href} data-stop={s.id} style={`--c:${s.color};--i:${s.ink}`}>
              {s.short}
            </a>
          </li>
        ))
      }
    </ul>
  </figcaption>
</figure>

<script>
  import { startStreet } from '../scripts/street/game';

  const fig = document.querySelector<HTMLElement>('[data-street]');
  if (fig) startStreet(fig, JSON.parse(fig.dataset.stops ?? '[]'));
</script>

<style>
  .street {
    margin: 0;
    border-radius: var(--radius-l);
    background: var(--bg-sunk);
    overflow: hidden;
  }
  .street:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }
  .stage {
    position: relative;
    display: none;
  }
  .street:global(.live) .stage {
    display: block;
  }
  canvas {
    display: block;
    width: 100%;
    /* Tall enough for both sides of the road, closer to the 3D walk's window. */
    height: clamp(400px, min(46vw, 66vh), 600px);
    cursor: pointer;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  /* Fullscreen: the real thing where the browser allows it, otherwise
     the street fills the window (iPhone Safari). */
  .street:fullscreen,
  .street:global(.immersive) {
    display: flex;
    flex-direction: column;
    border-radius: 0;
    background: var(--bg);
  }
  .street:global(.immersive) {
    /* Sized to the visible viewport (--vv-*, set by trackVisibleViewport) so the
       touch controls at the bottom are never pushed off-screen. */
    position: fixed;
    top: var(--vv-top, 0px);
    left: 0;
    right: 0;
    height: var(--vv-h, 100dvh);
    padding-bottom: env(safe-area-inset-bottom);
    z-index: 1000;
  }
  .street:fullscreen .stage,
  .street:global(.immersive) .stage {
    flex: 1;
    min-height: 0;
  }
  .street:fullscreen canvas,
  .street:global(.immersive) canvas {
    height: 100%;
    touch-action: none;
  }
  .street:fullscreen figcaption,
  .street:global(.immersive) figcaption {
    padding-block: 10px 12px;
  }
  /* Once the game runs, the stops are for discovering on the street (or in
     the site's own nav). The links stay in the page for screen readers and
     for the game, which follows them; without JavaScript they show. */
  .street:global(.live) .stops {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 520px) {
    .tools { gap: 6px; }
    .sound { padding: 0 11px; font-size: 13px; }
  }
  /* Keycaps for the controls: shown once the game runs, on keyboards only. */
  .keys {
    display: none;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin: 0;
    padding: 12px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .street:global(.live) .keys {
    display: flex;
  }
  @media (pointer: coarse) {
    .street:global(.live) .keys {
      display: none;
    }
  }
  .keys li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .caps {
    display: inline-flex;
    gap: 3px;
  }
  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 6px;
    border: 1px solid var(--line);
    border-bottom-width: 3px;
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }
  kbd.wide {
    padding: 0 8px;
    font-size: 10px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .what {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .street:fullscreen .keys,
  .street:global(.immersive) .keys {
    padding-top: 8px;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .sound {
    display: none;
    min-height: 36px;
    padding: 0 14px;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .street:global(.live) .sound {
    display: inline-flex;
    align-items: center;
  }
  .street:global(.live) .sound[hidden] { display: none; }
  .sound[aria-pressed='true'] {
    background: var(--saffron);
    border-color: var(--saffron);
    color: var(--navy-deep);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px clamp(16px, 3vw, 24px) 20px;
  }
  .caption {
    min-height: 1.6em;
    font-size: 14px;
    color: var(--ink-2);
  }
  .stops {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stops a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 2px solid var(--line);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .stops a:hover,
  .stops a:global(.near) {
    background: var(--c);
    border-color: var(--c);
    color: var(--i);
  }
  .stops a:global(.near) {
    transform: translateY(-2px);
  }

  .retro-booth {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    max-width: 480px;
    margin: 0 auto;
    padding: 8px 10px;
    background: #0f162b;
    color: #f4f1ea;
    border: 3px solid #f4f1ea;
    box-shadow: 4px 4px 0 #070b18;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    z-index: 6;
  }
  .retro-booth[hidden] { display: none; }
  .rb-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }
  .rb-head b {
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .rb-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .rb-link {
    padding: 3px 8px;
    border: 2px solid #5eea8c;
    color: #5eea8c;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
  }
  .rb-close {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 2px solid #f4f1ea;
    background: #1a284d;
    color: #f4f1ea;
    font: 800 14px/1 ui-monospace, monospace;
    cursor: pointer;
  }
  .rb-body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: center;
  }
  .rb-screen {
    display: block;
    width: 160px;
    height: 100px;
    image-rendering: pixelated;
    border: 2px solid #3c4f82;
    background: #070b18;
    cursor: pointer;
  }
  .rb-ctrl {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
  }
  .rb-ctrl :global(button) {
    padding: 4px 8px;
    border: 2px solid #3c4f82;
    background: #1a284d;
    color: #f4f1ea;
    font: 700 11px ui-monospace, monospace;
    cursor: pointer;
  }
  .rb-ctrl :global(button[aria-pressed='true']) {
    border-color: #f0c44d;
    background: #f0c44d;
    color: #0b1430;
  }
  .rb-ctrl :global(span.rb-stat) {
    font-size: 11px;
    color: #b7c2df;
    width: 100%;
  }
  @media (max-width: 600px) {
    .retro-booth { left: 6px; right: 6px; bottom: 6px; max-height: 44%; padding: 6px 8px; }
    .rb-body { gap: 8px; }
    .rb-screen { width: 128px; height: 80px; }
    .rb-ctrl :global(button) { padding: 3px 6px; font-size: 10px; }
  }
</style>
