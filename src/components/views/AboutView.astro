---
import Base from '../../layouts/Base.astro';
import { localePath, type Locale } from '../../i18n/utils';
import { getUi } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUi(locale).about;
---

<Base title={ui.title} description={ui.description} locale={locale}>
  <section class="wrap hero">
    <div class="text">
      <span class="eyebrow">{ui.eyebrow}</span>
      <h1>{ui.heading}</h1>
      <p class="lede">{ui.lede}</p>
    </div>
    <img class="portrait" src="/img/avatar.png" alt={ui.portraitAlt} width="320" height="320" />
  </section>

  <section class="wrap cols">
    <div class="prose">
      <h2>{ui.howIGotHereHeading}</h2>
      <p>
        {ui.howIGotHereP1BeforeScratch}<a href="https://scratch.mit.edu/projects/164378114/">{ui.howIGotHereScratchLink}</a>{ui.howIGotHereP1Middle}<a href={localePath(locale, '/projects/dopepod')}>dopepod</a>{ui.howIGotHereP1After}
      </p>
      <p>{ui.howIGotHereP2}</p>

      <h2>{ui.nowHeading}</h2>
      <p>
        {ui.nowBeforeLeash}<a href={localePath(locale, '/projects/path-of-leash-resistance')}>Path of Leash Resistance</a>{ui.nowBetweenLeashAndStemma}<a href={localePath(locale, '/projects/stemma')}>stemma</a>{ui.nowBetweenStemmaAndCoriolis}<a href={localePath(locale, '/projects/coriolis')}>Coriolis</a>{ui.nowBetweenCoriolisAndHow}<a href={localePath(locale, '/how-i-build')}>{ui.nowHowLink}</a>{ui.nowAfterHow}
      </p>

      <h2>{ui.workHeading}</h2>
      <h3>{ui.goforeTitle}</h3>
      <p>{ui.goforeBody}</p>
      <h3>{ui.solidabisTitle}</h3>
      <p>{ui.solidabisBody}</p>

      <h2>{ui.educationHeading}</h2>
      <ul>
        {
          ui.educationItems.map((item) => (
            <li>
              <strong>{item.school}</strong>, {item.detail}
            </li>
          ))
        }
      </ul>

      <h2>{ui.languagesHeading}</h2>
      <p>{ui.languagesBody}</p>
    </div>

    <aside class="side" aria-label={ui.sidebarAria}>
      {
        ui.skillGroups.map((s) => (
          <div>
            <h2>{s.group}</h2>
            <ul class="chips">{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))
      }
      <div class="contact">
        <h2>{ui.contactTitle}</h2>
        <p>{ui.contactBody}</p>
        <a class="btn btn-primary" href="mailto:santtu.nykanen@gmail.com">{ui.contactCta}</a>
      </div>
    </aside>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding-block: clamp(32px, 6vw, 64px) 48px;
  }
  .text {
    flex: 1 1 480px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h1 {
    font-size: clamp(48px, 7vw, 88px);
  }
  .lede {
    max-width: 620px;
    font-size: 20px;
    color: var(--ink-2);
  }
  .portrait {
    width: clamp(160px, 24vw, 280px);
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    clip-path: polygon(22% 0, 78% 0, 100% 22%, 100% 78%, 78% 100%, 22% 100%, 0 78%, 0 22%);
    background: var(--saffron);
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 72px;
    padding-bottom: 96px;
  }
  .cols .prose {
    flex: 999 1 560px;
    min-width: 0;
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  .prose h3 {
    font-size: 21px;
  }
  .side {
    flex: 1 1 260px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .side h2 {
    font-size: 18px;
    margin-bottom: 12px;
  }
  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 24px;
    background: var(--surface);
    border-radius: var(--radius-m);
  }
  .contact h2 {
    margin: 0;
  }
  .contact p {
    color: var(--ink-2);
  }
</style>
