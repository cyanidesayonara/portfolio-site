---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getLocalizedProject } from '../../i18n/content';
import { BCP47, localePath, type Locale } from '../../i18n/utils';
import { getUi } from '../../i18n/ui';

interface Props {
  locale: Locale;
  post: CollectionEntry<'blog'>;
  isFallback?: boolean;
}
const { locale, post, isFallback = false } = Astro.props;
const ui = getUi(locale);
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat(BCP47[locale], { day: 'numeric', month: 'long', year: 'numeric' });
const linkedProject = post.data.project ? await getLocalizedProject(locale, post.data.project) : undefined;
---

<Base title={post.data.title} description={post.data.description} image={post.data.cover} type="article" locale={locale}>
  <article class="wrap post">
    <header>
      <a class="back" href={localePath(locale, '/blog')}>{ui.common.allPosts}</a>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
        {
          linkedProject && (
            <a class="project-link" href={localePath(locale, `/projects/${linkedProject.slug}`)}>
              {ui.common.projectLabel}: {linkedProject.entry.data.title}
            </a>
          )
        }
      </div>
      <h1>{post.data.title}</h1>
      <p class="desc">{post.data.description}</p>
      {post.data.tags.length > 0 && <ul class="chips">{post.data.tags.map((t) => <li>{t}</li>)}</ul>}
    </header>
    {
      post.data.cover && (
        <img class="cover" src={post.data.cover} alt={post.data.coverAlt ?? ''} fetchpriority="high" />
      )
    }
    <div class="prose">
      {isFallback && <p class="fallback-note">{ui.common.englishFallbackNotice}</p>}
      <Content />
    </div>
  </article>
</Base>

<style>
  .post {
    max-width: 860px;
    padding-bottom: 96px;
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: clamp(24px, 4vw, 48px) 32px;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
  }
  .back::before {
    content: '←';
    margin-right: 8px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }
  time {
    font-size: 15px;
    color: var(--ink-2);
  }
  .project-link {
    display: inline-flex;
    align-items: center;
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .project-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  h1 {
    font-size: clamp(36px, 5.4vw, 60px);
  }
  .desc {
    font-size: 20px;
    color: var(--ink-2);
  }
  .cover {
    width: 100%;
    border-radius: var(--radius-l);
    margin-bottom: 40px;
  }
  .fallback-note {
    padding: 12px 16px;
    border-radius: var(--radius-s);
    background: var(--bg-sunk);
    color: var(--ink-2);
    font-size: 15px;
    margin-bottom: 24px;
  }
</style>
