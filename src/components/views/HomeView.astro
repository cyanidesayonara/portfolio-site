---
import Base from '../../layouts/Base.astro';
import StreetMap from '../StreetMap.astro';
import ProjectCard from '../ProjectCard.astro';
import PostList from '../PostList.astro';
import { getLocalizedProjects, getLocalizedPosts } from '../../i18n/content';
import { localePath, type Locale } from '../../i18n/utils';
import { getUi } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUi(locale);

const projects = (await getLocalizedProjects(locale)).filter((p) => p.entry.data.featured);
const posts = (await getLocalizedPosts(locale)).slice(0, 3);
---

<Base locale={locale}>
  <section class="hero wrap">
    <div class="intro">
      <span class="eyebrow">{ui.home.eyebrow}</span>
      <h1>{ui.home.headline}</h1>
      <p class="lede">{ui.home.lede}</p>
      <div class="cta">
        <a class="btn btn-primary" href={localePath(locale, '/projects')}>{ui.home.ctaProjects}</a>
        <a class="btn btn-ghost" href={localePath(locale, '/how-i-build')}>{ui.home.ctaHowIBuild}</a>
      </div>
    </div>
  </section>

  <section class="wrap" aria-label={ui.home.streetAria}>
    <StreetMap locale={locale} />
  </section>

  <section class="section wrap" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title" class="section-title">{ui.home.workTitle}</h2>
      <a href={localePath(locale, '/projects')}>{ui.home.allProjectsLink}</a>
    </div>
    <div class="work">
      {projects.map((p) => <ProjectCard project={p.entry} slug={p.slug} locale={locale} />)}
    </div>
  </section>

  <section class="wrap">
    <div class="how">
      <div class="how-text">
        <h2>{ui.home.howHeading}</h2>
        <p>{ui.home.howBody}</p>
        <a class="btn btn-primary" href={localePath(locale, '/how-i-build')}>{ui.home.howCta}</a>
      </div>
      <ol class="steps">
        {
          ui.home.steps.map((step) => (
            <li>
              <strong>{step.title}</strong>
              <span>{step.desc}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section wrap" aria-labelledby="blog-title">
        <div class="section-head">
          <h2 id="blog-title" class="section-title">{ui.home.blogTitle}</h2>
          <a href={localePath(locale, '/blog')}>{ui.home.allPostsLink}</a>
        </div>
        <PostList posts={posts} locale={locale} />
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: clamp(32px, 6vw, 72px) clamp(32px, 5vw, 56px);
  }
  .intro {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  h1 {
    font-size: clamp(44px, 6.6vw, 92px);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }
  .lede {
    max-width: 540px;
    font-size: 19px;
    color: var(--ink-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .work {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 24px;
  }
  .work > :global(.feature) {
    grid-column: 1 / -1;
  }
  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 48px;
    padding: clamp(32px, 6vw, 64px);
    background: var(--saffron);
    color: var(--navy-deep);
    border-radius: var(--radius-l);
  }
  .how-text {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .how h2 {
    font-size: clamp(34px, 4.6vw, 48px);
  }
  .how p {
    font-size: 18px;
  }
  .how .btn-primary {
    background: var(--navy-deep);
    color: var(--stone);
  }
  .steps {
    flex: 1 1 360px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    align-self: center;
  }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px;
    background: var(--stone);
    border-radius: var(--radius-m);
    counter-increment: step;
  }
  .steps li::before {
    content: '0' counter(step);
    font-size: 13px;
    font-weight: 600;
    color: #3a4a75;
  }
  .steps strong {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
  }
  .steps span {
    font-size: 14px;
    color: #3a4a75;
  }
</style>
