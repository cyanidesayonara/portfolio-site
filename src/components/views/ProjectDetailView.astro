---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectPager from '../ProjectPager.astro';
import PostList from '../PostList.astro';
import CoriolisSim from '../CoriolisSim.astro';
import { getPostsForProject, type LocalizedEntry } from '../../i18n/content';
import projectMeta from '../../data/project-meta.json';
import { BCP47, localePath, type Locale } from '../../i18n/utils';
import { getUi, tKind } from '../../i18n/ui';

interface Props {
  locale: Locale;
  slug: string;
  project: CollectionEntry<'projects'>;
  prev: LocalizedEntry<'projects'>;
  next: LocalizedEntry<'projects'>;
  isFallback?: boolean;
}

const { locale, slug, project, prev, next, isFallback = false } = Astro.props;
const ui = getUi(locale);
const p = project.data;
const { Content } = await render(project);
const relatedPosts = await getPostsForProject(locale, slug);
interface ProjectMeta {
  repo?: string;
  latestTag?: string | null;
  mainWalks?: number;
  bossCount?: number;
  commits?: number;
}
const meta = (projectMeta.projects as Record<string, ProjectMeta>)[slug];
const fmtNum = new Intl.NumberFormat(BCP47[locale]);
const numbers = [
  { label: ui.common.factWalks, value: meta?.mainWalks },
  { label: ui.common.factBosses, value: meta?.bossCount },
  { label: ui.common.factCommits, value: meta?.commits },
].flatMap(({ label, value }) => (value ? [{ label, value: fmtNum.format(value) }] : []));
---

<Base title={p.title} description={p.summary} image={p.cover} type="article" locale={locale}>
  <article>
    <header class="wrap head">
      <a class="back" href={localePath(locale, '/projects')}>{ui.common.allProjects}</a>
      <span class="kind" style={`--k: var(--${p.color})`}>{tKind(locale, p.kind)}{p.years && ` · ${p.years}`}</span>
      <h1>{p.title}</h1>
      <p class="tagline">{p.tagline}</p>
      {
        p.links.length > 0 && (
          <ul class="links">
            {p.links.map((l, i) => (
              <li>
                <a class:list={['btn', i === 0 ? 'btn-primary' : 'btn-ghost']} href={l.href}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="wrap">
      <div class:list={['cover', { dark: p.coverDark }]}>
        <img src={p.cover} alt={p.coverAlt} fetchpriority="high" />
      </div>
    </div>

    {
      slug === 'coriolis' && (
        <div class="wrap">
          <CoriolisSim locale={locale} />
        </div>
      )
    }

    <div class="wrap body">
      <div class="prose">
        {isFallback && <p class="fallback-note">{ui.common.englishFallbackNotice}</p>}
        <Content />
      </div>
      <aside class="facts" aria-label={ui.common.projectFactsAria}>
        <h2>{ui.common.builtWith}</h2>
        <ul class="chips">{p.stack.map((s) => <li>{s}</li>)}</ul>
        {
          meta?.latestTag && meta.repo && (
            <div class="release-fact">
              <h2>{ui.common.latestRelease}</h2>
              <a class="release-pill" href={`https://github.com/${meta.repo}/releases/tag/${meta.latestTag}`}>
                {meta.latestTag}
              </a>
            </div>
          )
        }
        {
          numbers.length > 0 && (
            <div class="number-facts">
              <h2>{ui.common.byTheNumbers}</h2>
              <dl>
                {numbers.map((n) => (
                  <div>
                    <dt>{n.label}</dt>
                    <dd>{n.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )
        }
      </aside>
    </div>
  </article>

  {
    relatedPosts.length > 0 && (
      <section class="wrap related" aria-labelledby="related-posts">
        <h2 id="related-posts" class="section-title">{ui.common.relatedPostsHeading}</h2>
        <PostList posts={relatedPosts} locale={locale} />
      </section>
    )
  }

  <div class="section wrap">
    <ProjectPager prev={prev} next={next} locale={locale} />
  </div>
</Base>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: clamp(24px, 4vw, 48px) 40px;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
  }
  .back::before {
    content: '←';
    margin-right: 8px;
  }
  .kind {
    align-self: flex-start;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--k);
    color: var(--navy-deep);
    font-size: 14px;
    font-weight: 600;
  }
  h1 {
    font-size: clamp(44px, 7vw, 88px);
  }
  .tagline {
    max-width: 720px;
    font-size: clamp(19px, 2vw, 22px);
    color: var(--ink-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .cover {
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--bg-sunk);
  }
  .cover.dark {
    background: #000;
  }
  .cover img {
    width: 100%;
    max-height: 720px;
    object-fit: contain;
    margin-inline: auto;
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    padding-block: 56px 24px;
  }
  .facts {
    flex: 1 1 220px;
    max-width: 300px;
  }
  .facts h2 {
    font-size: 18px;
    margin-bottom: 12px;
  }
  .release-fact,
  .number-facts {
    margin-top: 24px;
  }
  .number-facts dl {
    margin: 0;
  }
  .number-facts dl div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 4px;
  }
  .number-facts dt {
    color: var(--ink-2);
  }
  .number-facts dd {
    margin: 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .release-pill {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .release-pill:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .body .prose {
    flex: 999 1 560px;
    min-width: 0;
  }
  .related {
    padding-top: 24px;
  }
  .related .section-title {
    margin-bottom: 24px;
  }
  .fallback-note {
    padding: 12px 16px;
    border-radius: var(--radius-s);
    background: var(--bg-sunk);
    color: var(--ink-2);
    font-size: 15px;
    margin-bottom: 24px;
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.prose .gallery a.anim-toggle').forEach((link) => {
    link.addEventListener('click', (e) => {
      const anim = link.dataset.anim;
      const poster = link.dataset.poster;
      const img = link.querySelector('img');
      if (!anim || !poster || !img) return;
      e.preventDefault();
      const playing = link.classList.toggle('playing');
      img.src = playing ? anim : poster;
      const badge = link.querySelector('.anim-badge');
      if (badge) {
        badge.textContent = (playing ? link.dataset.labelStop : link.dataset.labelPlay) ?? '';
      }
    });
  });
</script>
