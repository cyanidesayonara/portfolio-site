---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../ProjectCard.astro';
import { getLocalizedProjects } from '../../i18n/content';
import type { Locale } from '../../i18n/utils';
import { getUi } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUi(locale).projectsIndex;

const all = await getLocalizedProjects(locale);
const featured = all.filter((p) => p.entry.data.featured);
const earlier = all.filter((p) => !p.entry.data.featured);
---

<Base title={ui.title} description={ui.description} locale={locale}>
  <section class="wrap head">
    <h1>{ui.heading}</h1>
    <p>{ui.intro}</p>
  </section>

  <section class="wrap" aria-label={ui.currentAria}>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p.entry} slug={p.slug} locale={locale} headingLevel="h2" />)}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="earlier">
    <h2 id="earlier" class="section-title">{ui.earlierHeading}</h2>
    <div class="grid small">
      {earlier.map((p) => <ProjectCard project={p.entry} slug={p.slug} locale={locale} variant="compact" />)}
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(32px, 6vw, 64px) 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h1 {
    font-size: clamp(48px, 7vw, 88px);
  }
  .head p {
    max-width: 620px;
    font-size: 19px;
    color: var(--ink-2);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 24px;
  }
  .grid > :global(.feature) {
    grid-column: 1 / -1;
  }
  .grid.small {
    margin-top: 32px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 20px;
  }
</style>
