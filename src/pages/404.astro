---
import Base from '../layouts/Base.astro';
import { getUi } from '../i18n/ui';

const ui = getUi('en').notFound;
---

<Base title={ui.title} noHreflang={true}>
  <section class="wrap lost">
    <span class="eyebrow">{ui.eyebrow}</span>
    <h1>{ui.heading}</h1>
    <p>{ui.body}</p>
    <a class="btn btn-primary" href="/">{ui.cta}</a>
  </section>
</Base>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-block: clamp(64px, 12vw, 140px);
    max-width: 860px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 72px);
  }
  p {
    font-size: 20px;
    color: var(--ink-2);
  }
</style>
