---
import BlogIndexView from '../../../components/views/BlogIndexView.astro';
import { NON_DEFAULT_LOCALES } from '../../../i18n/utils';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<BlogIndexView locale={lang} />
