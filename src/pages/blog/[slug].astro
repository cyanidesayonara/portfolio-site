---
import BlogPostView from '../../components/views/BlogPostView.astro';
import { getLocalizedPosts } from '../../i18n/content';

export async function getStaticPaths() {
  const posts = await getLocalizedPosts('en');
  return posts.map((item) => ({
    params: { slug: item.slug },
    props: { post: item.entry, isFallback: item.isFallback },
  }));
}

const { post, isFallback } = Astro.props;
---

<BlogPostView locale="en" post={post} isFallback={isFallback} />
