---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EixampleMap from '../components/EixampleMap.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="hero wrap">
    <div class="intro">
      <span class="eyebrow">Generalist full-stack developer</span>
      <h1>Software with a sense of humor, built properly.</h1>
      <p class="lede">
        I'm Santtu, a generalist developer and consultant at Gofore. Web, desktop, mobile, embedded:
        I go where the problem is. On my own time I ship complete products, from a desktop music tool
        to a browser game to an LED wall, and I build them with AI agents the way a lead works with a
        team.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="/projects">See the projects</a>
        <a class="btn btn-ghost" href="/how-i-build">How I build</a>
      </div>
    </div>
    <EixampleMap />
  </section>

  <section class="section wrap" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title" class="section-title">Things I've made</h2>
      <a href="/projects">All projects</a>
    </div>
    <div class="work">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="wrap">
    <div class="how">
      <div class="how-text">
        <h2>I direct, the agents type.</h2>
        <p>
          Briefs in, branches out, and nothing merges that I haven't read and played. That's how a
          whole batch of new levels for Path of Leash Resistance gets built at once.
        </p>
        <a class="btn btn-primary" href="/how-i-build">Read how it works</a>
      </div>
      <ol class="steps">
        <li><strong>Brief</strong><span>One written task per agent</span></li>
        <li><strong>Batch</strong><span>Parallel worktrees and branches</span></li>
        <li><strong>Ship</strong><span>Review, play, merge, release</span></li>
      </ol>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section wrap" aria-labelledby="blog-title">
        <div class="section-head">
          <h2 id="blog-title" class="section-title">From the blog</h2>
          <a href="/blog">All posts</a>
        </div>
        <PostList posts={posts} />
      </section>
    )
  }
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(32px, 5vw, 56px);
    padding-block: clamp(32px, 6vw, 72px) clamp(40px, 7vw, 80px);
  }
  .intro {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hero > :global(.map) {
    flex: 1 1 420px;
    min-width: 0;
  }
  h1 {
    font-size: clamp(44px, 6.6vw, 92px);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }
  .lede {
    max-width: 540px;
    font-size: 19px;
    color: var(--ink-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .work {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 24px;
  }
  .work > :global(.feature) {
    grid-column: 1 / -1;
  }
  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 48px;
    padding: clamp(32px, 6vw, 64px);
    background: var(--saffron);
    color: var(--navy-deep);
    border-radius: var(--radius-l);
  }
  .how-text {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .how h2 {
    font-size: clamp(34px, 4.6vw, 48px);
  }
  .how p {
    font-size: 18px;
  }
  .how .btn-primary {
    background: var(--navy-deep);
    color: var(--stone);
  }
  .steps {
    flex: 1 1 360px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    align-self: center;
  }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px;
    background: var(--stone);
    border-radius: var(--radius-m);
    counter-increment: step;
  }
  .steps li::before {
    content: '0' counter(step);
    font-size: 13px;
    font-weight: 600;
    color: #3a4a75;
  }
  .steps strong {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
  }
  .steps span {
    font-size: 14px;
    color: #3a4a75;
  }
</style>
