---
import ProjectDetailView from '../../components/views/ProjectDetailView.astro';
import { getLocalizedProjects } from '../../i18n/content';

export async function getStaticPaths() {
  const projects = await getLocalizedProjects('en');
  const n = projects.length;
  return projects.map((item, i) => ({
    params: { slug: item.slug },
    props: {
      slug: item.slug,
      project: item.entry,
      isFallback: item.isFallback,
      prev: projects[(i - 1 + n) % n],
      next: projects[(i + 1) % n],
    },
  }));
}

const { slug, project, isFallback, prev, next } = Astro.props;
---

<ProjectDetailView locale="en" slug={slug} project={project} isFallback={isFallback} prev={prev} next={next} />
