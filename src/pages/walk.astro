---
import Base from '../layouts/Base.astro';
import Walk3D from '../components/Walk3D.astro';
import songs from '../../public/audio/stemma/songs.json';

// CC BY tracks need their credit wherever they can play.
const credits = songs.songs.map((s) => ({
  title: s.title,
  who: s.credit_as ?? s.artist,
  licence: s.licence,
  licenceUrl: s.licence_url,
  source: s.source,
}));
---

<Base title="Walk in 3D · Path of Leash Resistance" description="An experiment in how Path of Leash Resistance could look in 3D: walk Millie from Carrer del Mar through the rail underpass to the Badalona seafront, the beach and the Pont del Petroli.">
  <section class="wrap head">
    <span class="eyebrow">Path of Leash Resistance · 3D experiment</span>
    <h1>Take Millie into 3D.</h1>
    <p class="lede">
      An experiment in how Path of Leash Resistance could look and feel in 3D. Walk Millie and her human down Carrer del Mar, under the railway and out along Badalona's seafront: the projects have pavilions on the boardwalk, the side streets hide favors to do, and the leash plays by the real game's rules.
    </p>
  </section>

  <section class="wrap game">
    <Walk3D />
    <p class="credits">
      Music: real songs split into stems by stemma, from its demo set.
      {credits.map((c, i) => (
        <>
          {i > 0 && ' · '}
          “<a href={c.source} rel="noopener">{c.title}</a>” by {c.who} (<a href={c.licenceUrl} rel="noopener">{c.licence}</a>)
        </>
      ))}
    </p>
  </section>
</Base>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: clamp(24px, 4vw, 48px) 24px;
  }
  h1 {
    font-size: clamp(38px, 6vw, 68px);
  }
  .lede {
    max-width: 760px;
    font-size: 18px;
    color: var(--ink-2);
  }
  .game {
    margin-bottom: 56px;
  }
  .credits {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
  }
</style>
