---
import Base from '../layouts/Base.astro';

const STOPS = [
  { id: 'leash', short: 'Leash', href: '/projects/path-of-leash-resistance', color: '#ffb020', ink: '#0b1430' },
  { id: 'stemma', short: 'stemma', href: '/projects/stemma', color: '#1fc9b7', ink: '#0b1430' },
  { id: 'coriolis', short: 'Coriolis', href: '/projects/coriolis', color: '#14203d', ink: '#5eea8c' },
  { id: 'about', short: 'About', href: '/about', color: '#8bcb3c', ink: '#0b1430' },
  { id: 'blog', short: 'Blog', href: '/blog', color: '#e5487a', ink: '#0b1430' },
  { id: 'how', short: 'How I build', href: '/how-i-build', color: '#14203d', ink: '#f4f1ea' },
  { id: 'park', short: 'Park', href: '/', color: '#5f9e4a', ink: '#0b1430' },
];

const KEYS = [
  { keys: ['W', 'A', 'S', 'D'], label: 'Move' },
  { keys: ['Shift'], label: 'Run' },
  { keys: ['V'], label: 'Jump' },
  { keys: ['Space'], label: 'Dig / Find' },
  { keys: ['Q'], label: 'Mark' },
  { keys: ['E'], label: 'Bark' },
  { keys: ['G'], label: 'Pick up' },
  { keys: ['X'], label: 'Wall / Mixer' },
  { keys: ['C'], label: 'Camera' },
  { keys: ['1–4'], label: 'Sky' },
  { keys: ['Tab'], label: 'Goals' },
  { keys: ['Enter'], label: 'Go in' },
  { keys: ['R'], label: 'Reset' },
];
---

<Base title="Walk the 3D street · PoLR 1.5" description="A 3D walkable neighborhood starring Millie, teasing Path of Leash Resistance 2 with pole whirls, buried finds, stemma audio stems and a live Coriolis LED wall.">
  <section class="wrap head">
    <span class="eyebrow">Path of Leash Resistance 1.5 · 3D Teaser</span>
    <h1>Take Millie into 3D.</h1>
    <p class="lede">
      A sandbox peek at where a 3D sequel could go: wind your human around lampposts for a Tetherball Pole Whirl, jump curbs onto the Mirador ramp, dig up buried finds, wake El Drac, mix live stems outside stemma, and play the real 128×128 Coriolis LED wall mounted right on the gallery facade.
    </p>
  </section>

  <section class="wrap">
    <figure class="walk-shell" data-walk-3d>
      <div class="stage" data-stage tabindex="0" role="application" aria-roledescription="game" aria-label="3D street game. Click or focus to play: WASD or arrows move, Shift runs, V jumps, Space digs, Q marks, E barks, X uses the wall or mixer, C changes camera, 1 to 4 change the sky, Tab shows goals, Enter goes into a shop. Shift+Tab or Escape leaves the game.">
        <!-- Top-left PoLR HUD -->
        <div class="hud-tl">
          <div class="hud-pill bars">
            <label><span>Mark</span><span class="track"><i class="fill pee" data-pee-fill style="width:75%"></i></span></label>
            <label><span>Patience</span><span class="track"><i class="fill pat" data-pat-fill style="width:100%"></i></span></label>
          </div>
          <div class="hud-pill status">
            <strong data-leash-badge>LEASHED</strong>
            <span data-stats>Bones 0/5 · Finds 0/3 · Goals 0/6</span>
          </div>
        </div>

        <!-- Top-right quick controls -->
        <div class="hud-tr">
          <div class="sky-group" role="group" aria-label="Sky and weather">
            <button type="button" data-weather="day" class="active">Day</button>
            <button type="button" data-weather="calima">Calima</button>
            <button type="button" data-weather="rain">Rain</button>
            <button type="button" data-weather="night">Night</button>
          </div>
          <button type="button" class="hud-btn" data-goals-toggle>Goals</button>
          <button type="button" class="hud-btn" data-camera>Cam: 3/4</button>
          <button type="button" class="hud-btn" data-sound aria-pressed="false">Sound off</button>
          <button type="button" class="hud-btn" data-fullscreen>Fullscreen</button>
        </div>

        <!-- Center toast & contextual prompt -->
        <div class="toast" data-toast aria-live="polite"></div>
        <div class="prompt" data-prompt aria-live="polite"></div>

        <!-- Goals Drawer -->
        <aside class="drawer goals-drawer" data-goals aria-label="Walk goals">
          <h3>PoLR 1.5 Goals</h3>
          <ul data-goals-list></ul>
        </aside>

        <!-- stemma 4-Stem Mixer Drawer -->
        <aside class="drawer stemma-drawer" data-stemma-panel aria-label="stemma 4-stem street mixer">
          <div class="drawer-head">
            <strong>stemma · Live 4-Stem Mixer</strong>
            <button type="button" data-stemma-close aria-label="Close mixer">×</button>
          </div>
          <p>Mute individual stems of the street's Andalusian soundtrack live:</p>
          <div class="stem-row">
            <button type="button" data-stem="lead" aria-pressed="true">Lead</button>
            <button type="button" data-stem="chords" aria-pressed="true">Chords</button>
            <button type="button" data-stem="bass" aria-pressed="true">Bass</button>
            <button type="button" data-stem="drums" aria-pressed="true">Drums</button>
          </div>
        </aside>

        <!-- Coriolis Remote Drawer (when focused on the 3D LED wall) -->
        <aside class="drawer coriolis-drawer" data-coriolis-panel aria-label="Coriolis 3D wall controls">
          <div class="drawer-head">
            <strong>Coriolis 128×128 LED Wall</strong>
            <button type="button" data-c-exit>Step back (X)</button>
          </div>
          <div class="c-pad">
            <button type="button" data-c-key="Up">▲</button>
            <button type="button" data-c-key="Left">◀</button>
            <button type="button" data-c-key="Select">OK</button>
            <button type="button" data-c-key="Right">▶</button>
            <button type="button" data-c-key="Down">▼</button>
          </div>
          <div class="c-cmds">
            <button type="button" data-c-cmd="Menu">Menu (M)</button>
            <button type="button" data-c-cmd="Settings">Settings (S)</button>
            <button type="button" data-c-cmd="Overlay">Clock (C)</button>
            <button type="button" data-c-cmd="Next">Next (Space)</button>
            <button type="button" data-c-key="Back">Back (⌫)</button>
          </div>
        </aside>

        <!-- Touch Action Buttons -->
        <div class="touch-pad" aria-label="Touch controls">
          <div class="touch-dpad">
            <button type="button" data-touch-key="KeyW">▲</button>
            <button type="button" data-touch-key="KeyA">◀</button>
            <button type="button" data-touch-key="KeyS">▼</button>
            <button type="button" data-touch-key="KeyD">▶</button>
          </div>
          <div class="touch-actions">
            <button type="button" data-touch-key="KeyV">Jump</button>
            <button type="button" data-touch-key="Space">Dig</button>
            <button type="button" data-touch-key="KeyE">Bark</button>
            <button type="button" data-touch-key="KeyQ">Mark</button>
            <button type="button" data-touch-key="KeyX">Use</button>
            <button type="button" data-touch-key="ShiftLeft">Run</button>
          </div>
        </div>
      </div>

      <figcaption class="foot">
        <p class="caption" data-caption>Walk the 3D Eixample street, wind lampposts for a Pole Whirl, dig buried finds, or play the Coriolis wall.</p>
        <ul class="keys" aria-label="Controls">
          {
            KEYS.map((k) => (
              <li>
                <span class="caps">
                  {k.keys.map((key) => (
                    <kbd class:list={{ wide: key.length > 1 }}>{key}</kbd>
                  ))}
                </span>
                <span class="what">{k.label}</span>
              </li>
            ))
          }
        </ul>
        <ul class="stops" aria-label="Stops on the 3D street">
          {
            STOPS.map((s) => (
              <li>
                <a href={s.href} data-stop={s.id} style={`--c:${s.color};--i:${s.ink}`}>
                  {s.short}
                </a>
              </li>
            ))
          }
        </ul>
      </figcaption>
    </figure>
  </section>
</Base>

<script>
  import { startWalk3D } from '../scripts/walk/game3d';

  const root = document.querySelector<HTMLElement>('[data-walk-3d]');
  if (root) startWalk3D(root);
</script>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: clamp(24px, 4vw, 48px) 24px;
  }
  h1 {
    font-size: clamp(38px, 6vw, 68px);
  }
  .lede {
    max-width: 760px;
    font-size: 18px;
    color: var(--ink-2);
  }
  .walk-shell {
    margin: 0 0 56px;
    border-radius: var(--radius-l);
    background: var(--bg-sunk);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .walk-shell:fullscreen,
  .walk-shell:global(.immersive) {
    display: flex;
    flex-direction: column;
    border-radius: 0;
  }
  .walk-shell:global(.immersive) {
    position: fixed;
    inset: 0;
    z-index: 1000;
    margin: 0;
  }
  .walk-shell:fullscreen .stage,
  .walk-shell:global(.immersive) .stage {
    flex: 1 1 auto;
    height: auto;
  }
  .stage {
    position: relative;
    height: clamp(400px, 56vh, 620px);
    background: #0b1430;
    overflow: hidden;
    user-select: none;
  }
  .stage:focus-visible {
    outline: 3px solid var(--accent, #ffb020);
    outline-offset: -3px;
  }
  .stage :global(.webgl-fallback) {
    margin: 0;
    padding: 32px;
    color: #f4efe6;
    max-width: 52ch;
  }
  .stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hud-tl {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
  }
  .hud-pill {
    background: rgba(11, 20, 48, 0.84);
    color: var(--stone);
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 12px;
    backdrop-filter: blur(6px);
  }
  .bars {
    display: flex;
    gap: 12px;
  }
  .bars label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-weight: 600;
  }
  .track {
    width: 78px;
    height: 7px;
    background: rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    transition: width 0.1s;
  }
  .fill.pee { background: var(--saffron); }
  .fill.pat { background: var(--turquoise); }
  .status {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .status strong {
    color: var(--led);
    letter-spacing: 0.04em;
  }

  .hud-tr {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    max-width: 65%;
  }
  .sky-group {
    display: inline-flex;
    background: rgba(11, 20, 48, 0.84);
    border-radius: 9px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }
  .sky-group button,
  .hud-btn {
    padding: 7px 10px;
    border: 0;
    background: transparent;
    color: var(--stone);
    font: 600 12px/1 var(--font-body);
    cursor: pointer;
  }
  .hud-btn {
    background: rgba(11, 20, 48, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9px;
  }
  .sky-group button.active,
  .hud-btn[aria-pressed='true'] {
    background: var(--saffron);
    color: var(--navy-deep);
  }

  .toast {
    position: absolute;
    top: 72px;
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--navy-deep);
    font: 800 14px/1 var(--font-display);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s, transform 0.15s;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);
  }
  .toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .prompt {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    padding: 9px 16px;
    border-radius: 10px;
    background: rgba(11, 20, 48, 0.9);
    color: var(--stone);
    border: 1px solid var(--led);
    font-size: 13px;
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
    max-width: calc(100% - 24px);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .prompt.show { opacity: 1; }

  .drawer {
    position: absolute;
    right: 12px;
    bottom: 56px;
    width: min(310px, calc(100% - 24px));
    padding: 14px 16px;
    border-radius: 14px;
    background: rgba(11, 20, 48, 0.94);
    color: var(--stone);
    border: 1px solid #304270;
    display: none;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
  }
  .drawer.open { display: flex; }
  .goals-drawer {
    left: 12px;
    right: auto;
    bottom: auto;
    top: 96px;
  }
  .goals-drawer h3 {
    font-size: 16px;
    color: var(--saffron);
  }
  .goals-drawer ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
  }
  .goals-drawer li.done { color: var(--led); }

  .drawer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .drawer-head button {
    padding: 4px 10px;
    border-radius: 7px;
    border: 1px solid #384e82;
    background: #172347;
    color: var(--stone);
    cursor: pointer;
    font-size: 12px;
  }
  .stem-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }
  .stem-row button {
    padding: 9px;
    border-radius: 8px;
    border: 1px solid var(--turquoise);
    background: rgba(31, 201, 183, 0.16);
    color: var(--stone);
    font-weight: 700;
    cursor: pointer;
  }
  .stem-row button.muted {
    border-color: #3a4a75;
    background: rgba(255, 255, 255, 0.05);
    color: #8896b8;
    text-decoration: line-through;
  }
  .c-pad {
    display: grid;
    grid-template-columns: repeat(3, 42px);
    gap: 5px;
    justify-content: center;
  }
  .c-pad button {
    height: 36px;
    border-radius: 8px;
    border: 1px solid #384e82;
    background: #162344;
    color: var(--stone);
    cursor: pointer;
  }
  .c-pad button:nth-child(1) { grid-column: 2; }
  .c-pad button:nth-child(2) { grid-column: 1; grid-row: 2; }
  .c-pad button:nth-child(3) { grid-column: 2; grid-row: 2; background: var(--led); color: var(--navy-deep); font-weight: 800; }
  .c-pad button:nth-child(4) { grid-column: 3; grid-row: 2; }
  .c-pad button:nth-child(5) { grid-column: 2; grid-row: 3; }
  .c-cmds {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .c-cmds button {
    padding: 5px 8px;
    border-radius: 6px;
    border: 1px solid #304270;
    background: #131e3d;
    color: var(--ink-soft-dark);
    font-size: 11px;
    cursor: pointer;
  }

  .touch-pad {
    display: none;
    position: absolute;
    inset-inline: 12px;
    bottom: 12px;
    justify-content: space-between;
    pointer-events: none;
  }
  @media (pointer: coarse) {
    .touch-pad { display: flex; }
  }
  .touch-dpad, .touch-actions {
    display: grid;
    grid-template-columns: repeat(3, 42px);
    gap: 4px;
    pointer-events: auto;
  }
  .touch-dpad button:nth-child(1) { grid-column: 2; }
  .touch-dpad button:nth-child(2) { grid-column: 1; grid-row: 2; }
  .touch-dpad button:nth-child(3) { grid-column: 2; grid-row: 2; }
  .touch-dpad button:nth-child(4) { grid-column: 3; grid-row: 2; }
  .touch-pad button {
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    padding: 10px 6px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(11, 20, 48, 0.78);
    color: var(--stone);
    font-size: 12px;
    font-weight: 700;
  }

  .foot {
    padding: 16px clamp(16px, 3vw, 24px) 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .caption {
    font-size: 14px;
    color: var(--ink-2);
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--ink-2);
  }
  .keys li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .caps {
    display: inline-flex;
    gap: 3px;
  }
  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 6px;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 2px 0 var(--line);
    font: 600 11px/1 var(--font-body);
    color: var(--ink);
  }
  .stops {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stops a {
    display: inline-flex;
    align-items: center;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--surface);
    border: 2px solid var(--c);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s, background-color 0.15s, color 0.15s;
  }
  .stops a:hover,
  .stops a:global(.near) {
    background: var(--c);
    color: var(--i);
    transform: translateY(-2px);
  }
</style>
